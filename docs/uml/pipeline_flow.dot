digraph pipeline {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="white"];
  edge [color="#444444"];

  subgraph cluster_img_opt_01_fov {
    label="IMG-OPT-01 FOV";
    style="dashed";
    color="#1f77b4";
    generate_fov_sim;
    fov_calc;
  }

  subgraph cluster_img_opt_02_distortion {
    label="IMG-OPT-02 Distortion";
    style="dashed";
    color="#ff7f0e";
    generate_distortion_sim;
    image_distortion;
  }

  subgraph cluster_img_opt_03_psf_quality {
    label="IMG-OPT-03 PSF quality";
    style="dashed";
    color="#2ca02c";
    generate_psf_quality_sim;
    prepare_psf_grid;
    process_one_psf;
    collect_strehls;
    plot_strehl_fov;
    img_03_test_outcome;
  }

  subgraph cluster_img_opt_04_stray_light {
    label="IMG-OPT-04 Stray light";
    style="dashed";
    color="#d62728";
    generate_stray_light_sim;
    populate_result_obj_info;
    stray_light_brightness_spectrum;
    img_04_test_outcome;
    centroid_2passes_oversample;
    stray_light_segmentation;
    stray_light_segmentation_combined;
    stray_light_mask_real;
  }

  subgraph cluster_img_opt_06_out_of_field_stray_light {
    label="IMG-OPT-06 Out-of-field stray light";
    style="dashed";
    color="#8c564b";
    generate_out_of_field_sim;
    metis_5838_attenuation;
    metis_9522_check;
    img_06_test_outcome;
  }

  subgraph cluster_img_rad_07_photometric_performance {
    label="IMG-RAD-07 Photometric performance";
    style="dashed";
    color="#9467bd";
    make_flat_frames;
  }

  generate_fov_sim [label="Generate FOV sims"];
  generate_distortion_sim [label="Generate distortion sims"];
  generate_psf_quality_sim [label="Generate PSF-quality sims"];
  generate_stray_light_sim [label="Generate stray-light sims"];
  generate_out_of_field_sim [label="Generate out-of-field sims"];
  make_flat_frames [label="Generate flats"];
  fov_calc [label="Compute FOV"];
  image_distortion [label="Measure distortion"];
  prepare_psf_grid [label="Load frame, 1st-pass centroids"];
  process_one_psf [label="Fit one PSF"];
  collect_strehls [label="Collect Strehl over FOV"];
  plot_strehl_fov [label="Plot Strehl over FOV"];
  img_03_test_outcome [label="IMG-OPT-03 pass/fail"];
  populate_result_obj_info [label="Populate result object"];
  stray_light_brightness_spectrum [label="Arrange segments into brightnesses as function of spatial scales"];
  img_04_test_outcome [label="IMG-OPT-04 pass/fail"];
  centroid_2passes_oversample [label="Centroid PSFs"];
  stray_light_segmentation [label="Segment stray light"];
  stray_light_segmentation_combined [label="Segment stray light (weighted combination of methods)"];
  stray_light_mask_real [label="Mask the real PSF"];
  metis_5838_attenuation [label="METIS-5838: out-of-field attenuation"];
  metis_9522_check [label="METIS-9522: artefacts vs. 3-sigma background"];
  img_06_test_outcome [label="IMG-OPT-06 pass/fail"];

  generate_fov_sim -> fov_calc;
  generate_distortion_sim -> image_distortion;
  generate_psf_quality_sim -> prepare_psf_grid;
  prepare_psf_grid -> process_one_psf;
  process_one_psf -> collect_strehls;
  collect_strehls -> plot_strehl_fov;
  collect_strehls -> img_03_test_outcome;
  generate_stray_light_sim -> populate_result_obj_info;
  stray_light_segmentation -> stray_light_brightness_spectrum;
  stray_light_segmentation_combined -> stray_light_brightness_spectrum;
  stray_light_brightness_spectrum -> img_04_test_outcome;
  populate_result_obj_info -> centroid_2passes_oversample;
  stray_light_mask_real -> stray_light_segmentation;
  stray_light_mask_real -> stray_light_segmentation_combined;
  centroid_2passes_oversample -> stray_light_mask_real;
  generate_out_of_field_sim -> metis_5838_attenuation;
  stray_light_mask_real -> metis_5838_attenuation;
  stray_light_segmentation -> metis_9522_check;
  stray_light_segmentation_combined -> metis_9522_check;
  metis_5838_attenuation -> img_06_test_outcome;
  metis_9522_check -> img_06_test_outcome;
}

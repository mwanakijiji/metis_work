digraph io {
  rankdir=TB;
  ranksep=0.55;
  nodesep=0.2;
  label="IMG-OPT-05 Optomechanical stability: SIM → ANALYSIS I/O map\ngold = config read, black = FITS written / read (edge labels: header cards), green = outputs";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_cfg {
    label="config/"; style=filled; fillcolor="#fff8dc"; color="#bbbbbb";
    y_config_file_IMG_OPT_05_optomechanical_stability_SIM_yaml [label="config_file_IMG_OPT_05_optomechanical_stability_SIM.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_common_observing_params_yaml [label="config_file_common_observing_params.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_OPT_05_optomechanical_stability_observing_yaml [label="config_file_IMG_OPT_05_optomechanical_stability_observing.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_OPT_05_optomechanical_stability_data_states_yaml [label="config_file_IMG_OPT_05_optomechanical_stability_data_states.yaml", shape=note, style=filled, fillcolor="white"];
  }
  subgraph cluster_IMG_OPT_05_optomechanical_stability_SIM {
    label="IMG_OPT_05_optomechanical_stability_SIM.py";
    style=filled; fillcolor="#f3f3d7"; color="#999999";
    IMG_OPT_05_optomechanical_stability_SIM__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    IMG_OPT_05_optomechanical_stability_SIM__simulate_metis_5422_stability [label="simulate_metis_5422_stability\nSimulated data for METIS-5422\n(position of the mask in CFO-FP2\nstable w.r.t", shape=box, style="rounded,filled", fillcolor="white"];
    IMG_OPT_05_optomechanical_stability_SIM__main -> IMG_OPT_05_optomechanical_stability_SIM__simulate_metis_5422_stability [style=dashed];
  }
  fits [shape=record, style=filled, fillcolor="#e8f0fb", label="{data/IMG_OPT_05_optomechanical_stability_simmed_data\n*.fits|<primary> PRIMARY header:\nTSCALE LIMTYPE FRAME NFRAMES T_REL PUP_X PUP_Y SHIFT_X\nSHIFT_Y SHIFTMAS PUPDIAM PIXSCALE PUPLEVEL SEQ_RMS REQ_ID\nCASE EXPECTED REQ_PLH SIMVER FILTER WCU_FP WCU_PP PSF_KERN\nND_FILT BB_TEMP NDIT DIT DIT_CFG SAT_ADU PEAKFRAC|{<x_BCKGD_SUBTED> BCKGD_SUBTED|<x_RAW_READOUT> RAW_READOUT|<x_BACKGROUND> BACKGROUND}}"];
  IMG_OPT_05_optomechanical_stability_SIM__simulate_metis_5422_stability -> fits;
  subgraph cluster_IMG_OPT_05_optomechanical_stability_ANALYSIS {
    label="IMG_OPT_05_optomechanical_stability_ANALYSIS.py + modules";
    style=filled; fillcolor="#f2f2f2"; color="#999999";
    IMG_OPT_05_optomechanical_stability_ANALYSIS__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    backbone_img_opt_05_optomech_stability__measure_positions [label="measure_positions", shape=box, style="rounded,filled", fillcolor="white"];
  }
  fits:primary -> IMG_OPT_05_optomechanical_stability_ANALYSIS__main [label="SAT_ADU"];
  fits:x_BCKGD_SUBTED -> backbone_img_opt_05_optomech_stability__measure_positions;
  y_config_file_IMG_OPT_05_optomechanical_stability_SIM_yaml -> IMG_OPT_05_optomechanical_stability_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_05_optomechanical_stability_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_05_optomechanical_stability_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_OPT_05_optomechanical_stability_observing_yaml -> IMG_OPT_05_optomechanical_stability_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_OPT_05_optomechanical_stability_data_states_yaml -> IMG_OPT_05_optomechanical_stability_ANALYSIS__main [color="#b8860b"];
  subgraph cluster_out {
    label="outputs"; style=filled; fillcolor="#e6f4e6"; color="#bbbbbb";
    o_logs_IMG_OPT_05_optomechanical_stability_logs [label="logs/IMG_OPT_05_optomechanical_stability_logs/", shape=folder, style=filled, fillcolor="white"];
  }
  IMG_OPT_05_optomechanical_stability_ANALYSIS__main -> o_logs_IMG_OPT_05_optomechanical_stability_logs [color="#2ca02c"];
}

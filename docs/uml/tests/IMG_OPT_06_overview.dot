digraph overview {
  rankdir=TB;
  ranksep=0.35;
  newrank=true;
  label="IMG-OPT-06 Out-of-field stray light: overview\npipeline stages (this test's + the shared ones it uses), then each stage's purpose and the result fields it writes";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_flow {
    label="pipeline stages"; style=rounded; color="#999999";
    node [shape=box, style="rounded,filled"];
    centroid_2passes_oversample [label="Centroid PSFs", fillcolor="#fde3e3", style="rounded,filled"];
    generate_out_of_field_sim [label="Generate out-of-field sims", fillcolor="#f2f2f2", style="rounded,filled"];
    img_06_fyi_plots [label="FYI plots", fillcolor="#eae1df", style="rounded,dashed,filled"];
    img_06_test_outcome [label="IMG-OPT-06 pass/fail", fillcolor="#eae1df", style="rounded,filled", penwidth=2];
    metis_5838_attenuation [label="METIS-5838: out-of-field attenuation", fillcolor="#eae1df", style="rounded,filled"];
    metis_9522_check [label="METIS-9522: artefacts vs. 3-sigma background", fillcolor="#eae1df", style="rounded,filled"];
    populate_result_obj_info [label="Populate result object", fillcolor="#fde3e3", style="rounded,filled"];
    sim_img_06_metis_5838 [label="SIM METIS-5838: out-of-field attenuation", fillcolor="#f2f2f2", style="rounded,filled"];
    stray_light_mask_real [label="Mask the real PSF", fillcolor="#fde3e3", style="rounded,filled"];
    stray_light_segmentation [label="Segment stray light", fillcolor="#fde3e3", style="rounded,filled"];
    stray_light_segmentation_combined [label="Segment stray light (weighted combination of methods)", fillcolor="#fde3e3", style="rounded,filled"];
    populate_result_obj_info -> centroid_2passes_oversample;
    sim_img_06_metis_5838 -> generate_out_of_field_sim;
    metis_5838_attenuation -> img_06_fyi_plots;
    metis_9522_check -> img_06_fyi_plots;
    metis_5838_attenuation -> img_06_test_outcome;
    metis_9522_check -> img_06_test_outcome;
    stray_light_mask_real -> metis_5838_attenuation;
    stray_light_segmentation -> metis_9522_check;
    stray_light_segmentation_combined -> metis_9522_check;
    generate_out_of_field_sim -> populate_result_obj_info;
    centroid_2passes_oversample -> stray_light_mask_real;
    stray_light_mask_real -> stray_light_segmentation;
    stray_light_mask_real -> stray_light_segmentation_combined;
  }
  stage_table [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dddddd"><B>stage</B></TD><TD BGCOLOR="#dddddd"><B>module</B></TD><TD BGCOLOR="#dddddd"><B>purpose (docstring)</B></TD><TD BGCOLOR="#dddddd"><B>writes</B></TD></TR><TR><TD ALIGN="LEFT">generate_out_of_field_sim</TD><TD ALIGN="LEFT">IMG_OPT_06_METIS_AIT_out_of_field_SIM.py</TD><TD ALIGN="LEFT">Generate IMG-OPT-06 out-of-field simulations, one set per<BR ALIGN="LEFT"/>requirement, as set in the scenario config<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">ATT_REQ, ATT_INJ, FOV_REQ, OOF_DIR,<BR ALIGN="LEFT"/>REF_PEAK, BACKGROUND_2<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">sim_img_06_metis_5838</TD><TD ALIGN="LEFT">IMG_OPT_06_METIS_AIT_out_of_field_SIM.py</TD><TD ALIGN="LEFT">Simulated data for METIS-5838: out-of-field irradiance<BR ALIGN="LEFT"/>attenuated by &gt;= 1e4<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">ATT_REQ, ATT_INJ, FOV_REQ, OOF_DIR,<BR ALIGN="LEFT"/>REF_PEAK, BACKGROUND_2<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">populate_result_obj_info</TD><TD ALIGN="LEFT">modules/stray_light_common.py</TD><TD ALIGN="LEFT">Populate the result object with information from the data<BR ALIGN="LEFT"/>state<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">wavel_central, pixel_scale<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">centroid_2passes_oversample</TD><TD ALIGN="LEFT">modules/stray_light_common.py</TD><TD ALIGN="LEFT">Centroid the PSF in the image of the result object, starting<BR ALIGN="LEFT"/>from first guesses of the positions<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">centroids<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">stray_light_mask_real</TD><TD ALIGN="LEFT">modules/stray_light_common.py</TD><TD ALIGN="LEFT">Mask the real PSF, so we can find the stray light<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">real_psf_mask<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">metis_5838_attenuation</TD><TD ALIGN="LEFT">modules/backbone_img_opt_06_out_of_field.py</TD><TD ALIGN="LEFT">Measure the attenuation of out-of-field irradiance<BR ALIGN="LEFT"/>(METIS-5838)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">psf_peak, stray_peak_irradiance,<BR ALIGN="LEFT"/>stray_mean_irradiance,<BR ALIGN="LEFT"/>stray_irradiance_noise,<BR ALIGN="LEFT"/>detection_threshold,<BR ALIGN="LEFT"/>attenuation_measured,<BR ALIGN="LEFT"/>attenuation_is_lower_limit,<BR ALIGN="LEFT"/>attenuation_req, verdict_metis_5838<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">stray_light_segmentation_combined</TD><TD ALIGN="LEFT">modules/stray_light_common.py</TD><TD ALIGN="LEFT">Segment the stray light with a weighted combination of the<BR ALIGN="LEFT"/>methods in SEGMENTATION_METHODS.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">segment_map, segmentation_method,<BR ALIGN="LEFT"/>segmentation_weights,<BR ALIGN="LEFT"/>segmentation_vote_fraction,<BR ALIGN="LEFT"/>method_label_maps, final_label_map<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">stray_light_segmentation</TD><TD ALIGN="LEFT">modules/stray_light_common.py</TD><TD ALIGN="LEFT">Segment the stray light<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">segment_map, segmentation_method<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">metis_9522_check</TD><TD ALIGN="LEFT">modules/backbone_img_opt_06_out_of_field.py</TD><TD ALIGN="LEFT">Measure the segmented stray light regions for METIS-9522, as<BR ALIGN="LEFT"/>for IMG-OPT-04: each region&#x27;s total flux and its limit,<BR ALIGN="LEFT"/>3-sigma of the backgro…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">regions, background_rms<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">img_06_test_outcome</TD><TD ALIGN="LEFT">modules/backbone_img_opt_06_out_of_field.py</TD><TD ALIGN="LEFT">Decide and log the pass/fail of each IMG-OPT-06 requirement,<BR ALIGN="LEFT"/>and of the whole test<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">pass_metis_9522, verdict_overall<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  img_06_fyi_plots -> stage_table [style=invis];
  img_06_test_outcome -> stage_table [style=invis];
}

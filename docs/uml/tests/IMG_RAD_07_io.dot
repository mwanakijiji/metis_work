digraph io {
  rankdir=TB;
  ranksep=0.55;
  nodesep=0.2;
  label="IMG-RAD-07 Photometric performance: SIM → ANALYSIS I/O map\ngold = config read, black = FITS written / read (edge labels: header cards), green = outputs";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_cfg {
    label="config/"; style=filled; fillcolor="#fff8dc"; color="#bbbbbb";
    y_config_file_IMG_RAD_07_phot_performance_SIM_yaml [label="config_file_IMG_RAD_07_phot_performance_SIM.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_common_observing_params_yaml [label="config_file_common_observing_params.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_RAD_07_phot_performance_observing_yaml [label="config_file_IMG_RAD_07_phot_performance_observing.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_RAD_07_phot_performance_data_states_yaml [label="config_file_IMG_RAD_07_phot_performance_data_states.yaml", shape=note, style=filled, fillcolor="white"];
  }
  subgraph cluster_IMG_RAD_07_photometric_performance_SIM {
    label="IMG_RAD_07_photometric_performance_SIM.py";
    style=filled; fillcolor="#ece4f3"; color="#999999";
    IMG_RAD_07_photometric_performance_SIM__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    IMG_RAD_07_photometric_performance_SIM__simulate_metis_2883 [label="simulate_metis_2883\nSimulated data for METIS-2883: the\nsource used for detector linearity\ncalibration shall provide an\nilluminati…", shape=box, style="rounded,filled", fillcolor="white"];
    IMG_RAD_07_photometric_performance_SIM__main -> IMG_RAD_07_photometric_performance_SIM__simulate_metis_2883 [style=dashed];
    IMG_RAD_07_photometric_performance_SIM__simulate_metis_3300 [label="simulate_metis_3300\nSimulated data for METIS-3300: the\nlevel of flux of the flat field\nshall be tunable to 15 discrete\nvalues and…", shape=box, style="rounded,filled", fillcolor="white"];
    IMG_RAD_07_photometric_performance_SIM__main -> IMG_RAD_07_photometric_performance_SIM__simulate_metis_3300 [style=dashed];
  }
  fits [shape=record, style=filled, fillcolor="#e8f0fb", label="{data/IMG_RAD_07_photometric_performance_simmed_data\n*.fits|<primary> PRIMARY header:\nSTEP N_STEPS BB_APER ND_TRANS EXPOSURE NOMFLUX FLUXFAC\nPATTAMP FILTER WCU_FP WCU_PP PSF_KERN ND_FILT BB_TEMP NDIT\nDIT DIT_CFG SAT_ADU PEAKFRAC REQ_ID CASE EXPECTED REQ_PLH\nSIMVER|{<x_BCKGD_SUBTED> BCKGD_SUBTED|<x_RAW_READOUT> RAW_READOUT|<x_BACKGROUND> BACKGROUND}}"];
  IMG_RAD_07_photometric_performance_SIM__simulate_metis_2883 -> fits;
  IMG_RAD_07_photometric_performance_SIM__simulate_metis_3300 -> fits;
  subgraph cluster_IMG_RAD_07_photometric_performance_ANALYSIS {
    label="IMG_RAD_07_photometric_performance_ANALYSIS.py + modules";
    style=filled; fillcolor="#f2f2f2"; color="#999999";
    IMG_RAD_07_photometric_performance_ANALYSIS__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    backbone_img_rad_07_phot__reduce_flats [label="reduce_flats", shape=box, style="rounded,filled", fillcolor="white"];
  }
  fits:primary -> IMG_RAD_07_photometric_performance_ANALYSIS__main [label="SAT_ADU"];
  fits:x_BCKGD_SUBTED -> backbone_img_rad_07_phot__reduce_flats;
  y_config_file_IMG_RAD_07_phot_performance_SIM_yaml -> IMG_RAD_07_photometric_performance_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_RAD_07_photometric_performance_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_RAD_07_photometric_performance_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_RAD_07_phot_performance_observing_yaml -> IMG_RAD_07_photometric_performance_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_RAD_07_phot_performance_data_states_yaml -> IMG_RAD_07_photometric_performance_ANALYSIS__main [color="#b8860b"];
  subgraph cluster_out {
    label="outputs"; style=filled; fillcolor="#e6f4e6"; color="#bbbbbb";
    o_logs_IMG_RAD_07_phot_logs [label="logs/IMG_RAD_07_phot_logs/", shape=folder, style=filled, fillcolor="white"];
  }
  IMG_RAD_07_photometric_performance_ANALYSIS__main -> o_logs_IMG_RAD_07_phot_logs [color="#2ca02c"];
}

digraph dataflow {
  rankdir=LR;
  ranksep=0.9;
  nodesep=0.12;
  label="IMG-OPT-05 Optomechanical stability: data flow of the result fields (ANALYSIS)\nsolid blue = stage writes the field, dashed grey = stage reads it; italic = property (derived)";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  node [shape=box, style="rounded,filled", fillcolor="white", penwidth=1.5];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run [label="StabilityRunResult(...)\n(in populate_run)"];
  IMG_OPT_05_optomechanical_stability_ANALYSIS_main [label="main", tooltip="Run the IMG-OPT-05 analysis for each data state (one frame sequence each)."];
  backbone_img_opt_05_optomech_stability_measure_positions [label="measure_positions", tooltip="Measure the pupil centre (pupil_centre) of each frame of the run (BCKGD_SUBTED),\none frame at a time, and the frame times (DATE-OBS). Warns if the sequence's span\ndiffers from the run's timescale by more than span_tolerance.\n\nOUTPUTS:\n- StabilityRunResult, with times, centres, centre_sigmas, radii"];
  backbone_img_opt_05_optomech_stability_plot_run [label="plot_run", tooltip="FYI plot in result.results_dir: the measured pupil offsets (mas on sky) vs. time,\nwith their noise, and the injected offsets (SHIFT_X/Y) if there; and the offsets\nin the x-y plane with the limit as a circle.\n\nOUTPUTS:\n- list[str]: written plot files"];
  backbone_img_opt_05_optomech_stability_log_test_outcome [label="log_test_outcome", tooltip="Log the outcome of the run's requirement (as decided by metis_5422_check) and\ncompare it with the injected truth (EXPECTED).\n\nOUTPUTS:\n- StabilityRunResult, with verdict_overall and consistent set"];
  backbone_img_opt_05_optomech_stability_log_summary [label="log_summary", tooltip="Log a table of all runs (requirement, instrument, timescale, case, RMS, verdict,\nexpected, consistency with the injected truth); METIS-1230 is NOT EVALUATED (no\nSIM data).\n\nOUTPUTS:\n- int: number of runs inconsistent with the injected truth"];
  subgraph cluster_StabilityRunResult {
    label="StabilityRunResult (backbone_img_opt_05_optomech_stability)";
    style=filled; fillcolor="#f3f3d7"; color="#999999";
    f_run_name [label="run_name", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_req_id [label="req_id", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_instrument [label="instrument", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_case [label="case", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_timescale_s [label="timescale_s", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_det_key [label="det_key", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_pix_scale [label="pix_scale", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_file_names [label="file_names", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_headers [label="headers", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_results_dir [label="results_dir", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_limits [label="limits", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_analysis_cfg [label="analysis_cfg", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_times [label="times", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_centres [label="centres", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_centre_sigmas [label="centre_sigmas", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_radii [label="radii", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_measured [label="measured", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_sigma [label="sigma", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_verdicts [label="verdicts", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_verdict_overall [label="verdict_overall", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_consistent [label="consistent", shape=note, style=filled, fillcolor="white", penwidth=1];
  }
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_run_name [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_req_id [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_instrument [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_case [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_timescale_s [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_det_key [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_pix_scale [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_file_names [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_headers [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_results_dir [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_limits [color="#1f77b4"];
  ctor_StabilityRunResult_backbone_img_opt_05_optomech_stability_populate_run -> f_analysis_cfg [color="#1f77b4"];
  f_file_names -> IMG_OPT_05_optomechanical_stability_ANALYSIS_main [color="#888888", style=dashed];
  f_headers -> IMG_OPT_05_optomechanical_stability_ANALYSIS_main [color="#888888", style=dashed];
  f_req_id -> IMG_OPT_05_optomechanical_stability_ANALYSIS_main [color="#888888", style=dashed];
  backbone_img_opt_05_optomech_stability_measure_positions -> f_centres [color="#1f77b4"];
  backbone_img_opt_05_optomech_stability_measure_positions -> f_centre_sigmas [color="#1f77b4"];
  backbone_img_opt_05_optomech_stability_measure_positions -> f_radii [color="#1f77b4"];
  backbone_img_opt_05_optomech_stability_measure_positions -> f_times [color="#1f77b4"];
  f_analysis_cfg -> backbone_img_opt_05_optomech_stability_measure_positions [color="#888888", style=dashed];
  f_file_names -> backbone_img_opt_05_optomech_stability_measure_positions [color="#888888", style=dashed];
  f_headers -> backbone_img_opt_05_optomech_stability_measure_positions [color="#888888", style=dashed];
  f_timescale_s -> backbone_img_opt_05_optomech_stability_measure_positions [color="#888888", style=dashed];
  f_run_name -> backbone_img_opt_05_optomech_stability_measure_positions [color="#888888", style=dashed];
  f_results_dir -> backbone_img_opt_05_optomech_stability_plot_run [color="#888888", style=dashed];
  f_measured -> backbone_img_opt_05_optomech_stability_plot_run [color="#888888", style=dashed];
  f_centre_sigmas -> backbone_img_opt_05_optomech_stability_plot_run [color="#888888", style=dashed];
  f_pix_scale -> backbone_img_opt_05_optomech_stability_plot_run [color="#888888", style=dashed];
  f_times -> backbone_img_opt_05_optomech_stability_plot_run [color="#888888", style=dashed];
  f_headers -> backbone_img_opt_05_optomech_stability_plot_run [color="#888888", style=dashed];
  f_limits -> backbone_img_opt_05_optomech_stability_plot_run [color="#888888", style=dashed];
  f_run_name -> backbone_img_opt_05_optomech_stability_plot_run [color="#888888", style=dashed];
  f_sigma -> backbone_img_opt_05_optomech_stability_plot_run [color="#888888", style=dashed];
  f_verdicts -> backbone_img_opt_05_optomech_stability_plot_run [color="#888888", style=dashed];
  backbone_img_opt_05_optomech_stability_log_test_outcome -> f_verdict_overall [color="#1f77b4"];
  backbone_img_opt_05_optomech_stability_log_test_outcome -> f_consistent [color="#1f77b4"];
  f_run_name -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];
  f_req_id -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];
  f_instrument -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];
  f_timescale_s -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];
  f_case -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];
  f_file_names -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];
  f_measured -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];
  f_sigma -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];
  f_limits -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];
  f_verdicts -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];
  f_headers -> backbone_img_opt_05_optomech_stability_log_test_outcome [color="#888888", style=dashed];

  f_req_id -> backbone_img_opt_05_optomech_stability_log_summary [color="#888888", style=dashed];
  f_instrument -> backbone_img_opt_05_optomech_stability_log_summary [color="#888888", style=dashed];
  f_timescale_s -> backbone_img_opt_05_optomech_stability_log_summary [color="#888888", style=dashed];
  f_case -> backbone_img_opt_05_optomech_stability_log_summary [color="#888888", style=dashed];
  f_sigma -> backbone_img_opt_05_optomech_stability_log_summary [color="#888888", style=dashed];
  f_verdict_overall -> backbone_img_opt_05_optomech_stability_log_summary [color="#888888", style=dashed];

digraph io {
  rankdir=TB;
  ranksep=0.55;
  nodesep=0.2;
  label="IMG-OPT-01 FOV (need distortion info): SIM → ANALYSIS I/O map\ngold = config read, black = FITS written / read (edge labels: header cards), green = outputs";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_cfg {
    label="config/"; style=filled; fillcolor="#fff8dc"; color="#bbbbbb";
    y_config_file_IMG_OPT_01_METIS_AIT_img_cal_fov_SIM_yaml [label="config_file_IMG_OPT_01_METIS_AIT_img_cal_fov_SIM.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_common_observing_params_yaml [label="config_file_common_observing_params.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_OPT_01_METIS_AIT_img_cal_fov_ANALYSIS_yaml [label="config_file_IMG_OPT_01_METIS_AIT_img_cal_fov_ANALYSIS.yaml", shape=note, style=filled, fillcolor="white"];
  }
  subgraph cluster_IMG_OPT_01_METIS_AIT_img_cal_fov_SIM {
    label="IMG_OPT_01_METIS_AIT_img_cal_fov_SIM.py";
    style=filled; fillcolor="#d7e7f2"; color="#999999";
    IMG_OPT_01_METIS_AIT_img_cal_fov_SIM__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    IMG_OPT_01_METIS_AIT_img_cal_fov_SIM__simulate_metis_1095 [label="simulate_metis_1095\nSimulated data for METIS-1095: the\nFoV shall be 10.0 +1.0/-0.0 arcsec\n(LM) and 13.47 +0.50/-0.99 arcsec\n(N)", shape=box, style="rounded,filled", fillcolor="white"];
    IMG_OPT_01_METIS_AIT_img_cal_fov_SIM__main -> IMG_OPT_01_METIS_AIT_img_cal_fov_SIM__simulate_metis_1095 [style=dashed];
  }
  fits [shape=record, style=filled, fillcolor="#e8f0fb", label="{data/IMG_OPT_01_fov_simmed_data\n*.fits|<primary> PRIMARY header:\nDITHER DITHX DITHY DITHNOM FOV_TRUE REQ_ID CASE EXPECTED\nREQ_PLH SIMVER FILTER WCU_FP WCU_PP PSF_KERN ND_FILT BB_TEMP\nNDIT DIT DIT_CFG SAT_ADU PEAKFRAC|{<x_BCKGD_SUBTED> BCKGD_SUBTED|<x_RAW_READOUT> RAW_READOUT|<x_BACKGROUND> BACKGROUND}}"];
  IMG_OPT_01_METIS_AIT_img_cal_fov_SIM__simulate_metis_1095 -> fits;
  subgraph cluster_IMG_OPT_01_METIS_AIT_img_cal_fov_ANALYSIS {
    label="IMG_OPT_01_METIS_AIT_img_cal_fov_ANALYSIS.py + modules";
    style=filled; fillcolor="#f2f2f2"; color="#999999";
    IMG_OPT_01_METIS_AIT_img_cal_fov_ANALYSIS__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    backbone_img_opt_01_fov__fov_calc [label="fov_calc", shape=box, style="rounded,filled", fillcolor="white"];
  }
  fits:primary -> backbone_img_opt_01_fov__fov_calc [label="REQ_ID, CASE, REQ_QTY, INJ_VAL, EXPECTED"];
  y_config_file_IMG_OPT_01_METIS_AIT_img_cal_fov_SIM_yaml -> IMG_OPT_01_METIS_AIT_img_cal_fov_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_01_METIS_AIT_img_cal_fov_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_01_METIS_AIT_img_cal_fov_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_OPT_01_METIS_AIT_img_cal_fov_ANALYSIS_yaml -> IMG_OPT_01_METIS_AIT_img_cal_fov_ANALYSIS__main [color="#b8860b"];
  subgraph cluster_out {
    label="outputs"; style=filled; fillcolor="#e6f4e6"; color="#bbbbbb";
    o_logs_IMG_OPT_01_fov_analysis_logs [label="logs/IMG_OPT_01_fov_analysis_logs/", shape=folder, style=filled, fillcolor="white"];
  }
  IMG_OPT_01_METIS_AIT_img_cal_fov_ANALYSIS__main -> o_logs_IMG_OPT_01_fov_analysis_logs [color="#2ca02c"];
}

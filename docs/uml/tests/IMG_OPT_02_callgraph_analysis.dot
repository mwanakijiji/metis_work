  IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS__main -> backbone_img_opt_02_distortion__metis_8222_detector_offset [label="10", style=dashed];
  IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS__main -> backbone_img_opt_02_distortion__metis_9920_scale_stability [label="11", style=dashed];
  IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS__main -> backbone_img_opt_02_distortion__log_test_outcome [label="12"];

    label="modules/tbd_warnings.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    tbd_warnings__log_tbd_distortion [label="log_tbd_distortion\nLog a prominent warning that\ndistortion info from DD is still\nneeded", tooltip="Log a prominent warning that distortion info from DD is still needed.", shape=ellipse];
    tbd_warnings__stamp_all_saved_figures [label="stamp_all_saved_figures\nFrom now on in this process, stamp\nthe warning banner on every\nmatplotlib figure before it is\nsaved (Figure.s…", tooltip="From now on in this process, stamp the warning banner on every matplotlib figure\nbefore it is saved (Figure.savefig, which plt.savefig also calls). For scripts whose\nplots are made deep in shared modules.", shape=ellipse];
    tbd_warnings__add_tbd_banner [label="add_tbd_banner\nStamp a red warning banner across\nthe top of a matplotlib figure\n(once)", tooltip="Stamp a red warning banner across the top of a matplotlib figure (once).", shape=ellipse];
  }
  subgraph cluster_config_common {
    label="modules/config_common.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    config_common__load_observing_config [label="load_observing_config\nLoad the common observing config,\nthen merge each test-specific\nconfig on top, in order (top-level\nkeys of la…", tooltip="Load the common observing config, then merge each test-specific config on top, in\norder (top-level keys of later files override earlier ones).\n\nINPUTS\n----------\nstem : str\n    Project root (METIS_MAIT_code_eckhart/), prepended to relative paths.\n*test_config_files : str\n    Test-specific observing configs, relative to stem or absolute.\n\nOUTPUTS\n-------\ndict\n    The merged observing config.", shape=ellipse];
  }
  subgraph cluster_backbone_img_opt_02_distortion {
    label="modules/backbone_img_opt_02_distortion.py";
    style=filled; fillcolor="#ffe8d4"; color="#999999";
    backbone_img_opt_02_distortion__image_distortion [label="image_distortion\nMeasure Strehl-related quantities\nfor a grid of PSFs, save the per-\nPSF results, and generate a\nsummary diagno…", tooltip="Measure Strehl-related quantities for a grid of PSFs, save the per-PSF results,\nand generate a summary diagnostic plot over the detector frame.\n\nINPUTS\n----------\nfile_name : str\n    Path to the FITS file containing the PSF grid to analyze.\nfp_mask : str\n    Focal-plane mask label used for bookkeeping and output naming.\npp_mask : str\n    Pupil-plane mask label used for bookkeeping and output naming.\nfilter_name : str, optional\n    Name of the observing filter associated with the PSF grid.\nfit_simmed_psf : bool, optional\n    Whether to evaluate the ScopeSim-based Strehl workflow if enabled downstream.\nfit_annular_aperture_free : bool, optional\n    Whether to evaluate the free-geometry annular-aperture Strehl fit.\nfit_annular_aperture_fixed : bool, optional\n    Whether to evaluate the fixed-geometry annular-aperture Strehl fit.\npsfs_subset : str or int, optional\n    Either ``\"all\"`` to process the full grid or an integer giving how many PSFs\n    from the start of the centroid list to process.\nconfig_coords_guesses_file_name : str, optional\n    Path to the configuration file containing initial coordinate guesses.\nconfig_observing : dict, optional\n    Observing configuration dictionary passed to downstream PSF-fitting routines.\nresults_write_dir : str, optional\n    Directory where pickled results and diagnostic figures are saved.\nfit_method : str, optional\n    Name of the fitting backend to use for the free annular-aperture fit.\n\nOUTPUTS\n-------\nNone\n    Writes a pickle containing per-PSF Strehl results and a summary pass/fail flag,\n    and saves a detector-frame diagnostic plot annotated with Strehl values.", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_02_distortion__metis_1097_pixel_scale [label="metis_1097_pixel_scale\nMETIS-1097: the Imager shall\nprovide a pixel scale of 5.47\n+0.26/-0.26 mas/pix for the LM-\nband and 6.79 +0.25…", tooltip="METIS-1097: the Imager shall provide a pixel scale of 5.47 +0.26/-0.26 mas/pix for\nthe LM-band and 6.79 +0.25/-0.50 mas/pix for the N-band.\n\nSTUB: pixel scale calculation machinery TBD.\n\nINPUTS:\n- centroid_results_all (dict): per-PSF centroid results from image_distortion\n- filter_name (str): observing filter (selects the LM- or N-band limits)\n- config_observing (dict): observing configuration\n\nOUTPUTS:\n- verdict (str): PASS, FAIL or INCONCLUSIVE", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_02_distortion__metis_3502_residual_distortion [label="metis_3502_residual_distortion\nMETIS-3502: after calibration, the\ndistortions introduced by METIS\nshall be removed to better than\n0.5 mas (ca", tooltip="METIS-3502: after calibration, the distortions introduced by METIS shall be removed\nto better than 0.5 mas (ca. 1/10 px for the L-band imager) over the full field of\nview.\n\nSTUB: distortion calculation machinery TBD.\n\nINPUTS:\n- centroid_results_all (dict): per-PSF centroid results from image_distortion\n- filter_name (str): observing filter\n- config_observing (dict): observing configuration\n\nOUTPUTS:\n- verdict (str): PASS, FAIL or INCONCLUSIVE", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_02_distortion__metis_8222_detector_offset [label="metis_8222_detector_offset\nMETIS-8222: the center of the H2RG\nchip within IMG-LM-DET shall be\noffset from the METIS optical axis\nby 175…", tooltip="METIS-8222: the center of the H2RG chip within IMG-LM-DET shall be offset from the\nMETIS optical axis by 175 mas +/- 25 mas on-sky PtV in the 'across H2RG stripe'\ndirection (i.e., perpendicular to the orientation of the 32 stripes in the H2RG\ndetector). Applies to the LM-band detector only.\n\nSTUB: centering calculation machinery TBD.\n\nINPUTS:\n- centroid_results_all (dict): per-PSF centroid results from image_distortion\n- filter_name (str): observing filter\n- config_observing (dict): observing configuration\n\nOUTPUTS:\n- verdict (str): PASS, FAIL or INCONCLUSIVE", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_02_distortion__metis_9920_scale_stability [label="metis_9920_scale_stability\nMETIS-9920: image scale and\ndistortion of METIS shall be\nconstant (for each optical\nconfiguration, even after…", tooltip="METIS-9920: image scale and distortion of METIS shall be constant (for each optical\nconfiguration, even after change of observing modes) to an accuracy of 1e-3 (goal:\n1e-4) at L/M-band and 2e-3 (goal: 2e-4) at N-band with respect to the full field of\nview.\n\nSTUB: stability calculation machinery TBD (needs measurements of the same\nconfiguration before and after a change of observing mode).\n\nINPUTS:\n- centroid_results_all (dict): per-PSF centroid results from image_distortion\n- filter_name (str): observing filter (selects the L/M- or N-band limit)\n- config_observing (dict): observing configuration\n\nOUTPUTS:\n- verdict (str): PASS, FAIL or INCONCLUSIVE", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_02_distortion__log_test_outcome [label="log_test_outcome\nDecide and log the pass/fail of\neach IMG-OPT-02 requirement, and\nof the whole test", tooltip="Decide and log the pass/fail of each IMG-OPT-02 requirement, and of the whole test.\n\nOverall: PASS only if all requirements pass; FAIL if any fails; else INCONCLUSIVE.\n\nSTUB: the requirement checks are stubs, so the outcome is INCONCLUSIVE for now.\n\nINPUTS:\n- verdicts (dict): requirement ID (e.g. 'METIS-1097') -> verdict (PASS, FAIL or\n  INCONCLUSIVE)\n- file_name (str): FITS file the verdicts are for\n\nOUTPUTS:\n- verdict_overall (str): PASS, FAIL or INCONCLUSIVE", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_02_distortion__process_one_psf_image_distortion [label="process_one_psf_image_distortion\nProcess one PSF cutout by\noversampling it, centroiding it\nwith a Gaussian fit, and\noptionally evaluating addi…", tooltip="Process one PSF cutout by oversampling it, centroiding it with a Gaussian fit,\nand optionally evaluating additional Strehl estimators.\n\nINPUTS\n----------\nnum_coord : int\n    Zero-based index of the PSF currently being processed.\nnum_psfs_to_process : int\n    Total number of PSFs being processed from this detector image.\noriginal_array : np.ndarray\n    Native-sampling 2D array\noversample_factor : int\n    Factor used to oversample the PSF cutout before centroiding and model fitting.\ncoords_1st_pass_oversamp : list[float, float]\n    X and Y coordinates of the 1st-pass centroid in oversampled pixel coordinates\n    (using the full 2D array)\nfilter_name : str\n    Name of the observing filter associated with the PSF.\nfp_mask : str\n    Focal-plane mask label used for bookkeeping and plot naming.\npp_mask : str\n    Pupil-plane mask label used for bookkeeping and plot naming.\nconfig_observing : dict\n    Observing configuration dictionary passed to downstream fitting routines.\nresults_write_dir : str\n    Directory where diagnostic plots and fit products are written.\nfit_method : str\n    Name of the fitting backend to use for the free annular-aperture fit.\nfit_simmed_psf : bool\n    Whether to evaluate the ScopeSim-based Strehl workflow if enabled.\nfit_annular_aperture_fixed : bool\n    Whether to evaluate the fixed-geometry annular-aperture Strehl fit.\nfit_annular_aperture_free : bool\n    Whether to evaluate the free-geometry annular-aperture Strehl fit.\n\nOUTPUTS\n-------\nSinglePsfFitResult\n    Dataclass containing the Gaussian-fit centroid/FWHM/amplitude values in native\n    pixel units, the Gaussian-based Strehl estimate, and any optional Strehl\n    metrics.", shape=ellipse];
  }
  IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS__main -> paths__project_root [label="1"];
  IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS__main -> helpers__setup_logging [label="2"];

digraph callgraph {
  rankdir=LR;
  ranksep=0.6;
  nodesep=0.15;
  label="IMG-OPT-05 Optomechanical stability: SIM call graph (IMG_OPT_05_optomechanical_stability_SIM.py)\nbox = @pipeline_stage, oval = helper, dashed box = class instantiated, dashed arrow = passed as callback; numbers = call order in main(); hover for the full docstring";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_IMG_OPT_05_optomechanical_stability_SIM {
    label="IMG_OPT_05_optomechanical_stability_SIM.py";
    style=filled; fillcolor="#f2f2f2"; color="#999999";
    IMG_OPT_05_optomechanical_stability_SIM__main [label="main\nIMG-OPT-05 optomechanical\nstability simulations, one set per\nrequirement, as set in the\nscenario config (METI…", tooltip="IMG-OPT-05 optomechanical stability simulations, one set per requirement, as set\nin the scenario config (METIS-5422; METIS-1230 is a stub).", shape=box, style="filled,bold", fillcolor="white"];
    IMG_OPT_05_optomechanical_stability_SIM__simulate_metis_1230_flux_calibration [label="simulate_metis_1230_flux_calibration\nStub for METIS-1230 (on-sky flux\ncalibration not more often than\nonce per hour per instrument\nmode): writes n…", tooltip="Stub for METIS-1230 (on-sky flux calibration not more often than once per hour per\ninstrument mode): writes nothing.\n\nOUTPUTS:\n- list[str]: written files (empty)", shape=box, style="filled", fillcolor="white"];
    IMG_OPT_05_optomechanical_stability_SIM__simulate_metis_5422_stability [label="simulate_metis_5422_stability\nSimulated data for METIS-5422\n(position of the mask in CFO-FP2\nstable w.r.t", tooltip="Simulated data for METIS-5422 (position of the mask in CFO-FP2 stable w.r.t. the\nIMG detectors, as RMS on sky per timescale), tested with pupil imaging: for each\ntimescale (timescales_s), case and the instrument, n_frames frames evenly spread\nover the timescale, each an independent ScopeSim dark readout plus a sharp pupil\nimage (pupil_image) with photon noise, jittered by offsets (jitter_track) whose 2D\nRMS is the case's injected position_rms (mas on sky). Written into\n<out_dir>/<timescale>s_<instrument>/, with timestamps and the per-frame truth in\nthe header (see the module docstring).\n\nOUTPUTS:\n- list[str]: written files", shape=box, style="filled", fillcolor="white"];
    IMG_OPT_05_optomechanical_stability_SIM___stub [label="_stub\nLog that a requirement's\nsimulation is a stub; nothing is\nwritten", tooltip="Log that a requirement's simulation is a stub; nothing is written.", shape=ellipse];
    IMG_OPT_05_optomechanical_stability_SIM__timescale_label [label="timescale_label\nTimescale label in file and\ndirectory names, e.g", tooltip="Timescale label in file and directory names, e.g. '10s', '3600s'.", shape=ellipse];
    IMG_OPT_05_optomechanical_stability_SIM__frame_times [label="frame_times\nFrame times [s] from the sequence\nstart, evenly spanning the\ntimescale", tooltip="Frame times [s] from the sequence start, evenly spanning the timescale.", shape=ellipse];
    IMG_OPT_05_optomechanical_stability_SIM__jitter_track [label="jitter_track\nRandom jitter: independent\nGaussian offsets (dx, dy) per\nframe, with their mean removed and\nscaled so that th…", tooltip="Random jitter: independent Gaussian offsets (dx, dy) per frame, with their mean\nremoved and scaled so that their 2D RMS sqrt(mean(dx^2 + dy^2)) is exactly rms_px.\n\nOUTPUTS:\n- ndarray: dx (n_frames,)\n- ndarray: dy (n_frames,)", shape=ellipse];
    IMG_OPT_05_optomechanical_stability_SIM__track_rms [label="track_rms\n2D RMS of offsets about their\nmean: sqrt(mean((dx - <dx>)^2 +\n(dy - <dy>)^2))", tooltip="2D RMS of offsets about their mean: sqrt(mean((dx - <dx>)^2 + (dy - <dy>)^2)).", shape=ellipse];
    IMG_OPT_05_optomechanical_stability_SIM__pupil_image [label="pupil_image\nSharp pupil image: a uniform disk\nof diameter diameter_px centred at\ncentre_xy (x, y; pixel centres at\nintege…", tooltip="Sharp pupil image: a uniform disk of diameter diameter_px centred at centre_xy\n(x, y; pixel centres at integer coordinates), each pixel weighted by the fraction of\nits area inside the disk. Pixels within 0.75 px of the edge get that fraction from\noversample x oversample sub-pixels; the others are 0 or 1. The image's centroid then\nfollows sub-pixel shifts to ~0.1% (a linear ramp in the distance to the edge moves\nit only ~0.987x the shift).\n\nOUTPUTS:\n- ndarray: values in [0, 1]", shape=ellipse];
    IMG_OPT_05_optomechanical_stability_SIM__dark_readout [label="dark_readout\nOne more dark readout (detector\nnoise drawn anew) of the last\nobservation, which must have been\ntaken with th…", tooltip="One more dark readout (detector noise drawn anew) of the last observation, which\nmust have been taken with the WCU black-body aperture closed.", shape=ellipse];
    IMG_OPT_05_optomechanical_stability_SIM__fyi_plot_tracks [label="fyi_plot_tracks\nFYI plot of the injected jitter\ntracks of one case: offsets (mas\non sky) vs", tooltip="FYI plot of the injected jitter tracks of one case: offsets (mas on sky) vs. time,\nper timescale, with the RMS of each sequence.\n\nINPUTS:\n- plot_dir (str): where to write fyi_sim_<label>.png\n- label (str): e.g. 'METIS-5422_Lp_pass'\n- tracks (dict): timescale [s] -> (times [s], dx [px], dy [px])\n- pix_scale (float): mas / px\n- limit_mas (float): requirement limit on the RMS (mas)\n\nOUTPUTS:\n- str: path of the written plot", shape=ellipse];
  }
  subgraph cluster_paths {
    label="modules/paths.py";

digraph overview {
  rankdir=TB;
  ranksep=0.35;
  newrank=true;
  label="IMG-RAD-11 Background systematics with chopper (stub): overview\npipeline stages (this test's + the shared ones it uses), then each stage's purpose and the result fields it writes";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_flow {
    label="pipeline stages"; style=rounded; color="#999999";
    node [shape=box, style="rounded,filled"];
    generate_background_systematics_sim [label="Generate chopper background sims", fillcolor="#f2f2f2", style="rounded,dashed,filled"];
    simulate_rad_11_chopper_background [label="SIM chopped background (stub: reqs TBD)", fillcolor="#f0f5fb", style="rounded,dashed,filled"];
    simulate_rad_11_chopper_background -> generate_background_systematics_sim;
  }
  stage_table [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dddddd"><B>stage</B></TD><TD BGCOLOR="#dddddd"><B>module</B></TD><TD BGCOLOR="#dddddd"><B>purpose (docstring)</B></TD><TD BGCOLOR="#dddddd"><B>writes</B></TD></TR><TR><TD ALIGN="LEFT">generate_background_systematics_sim</TD><TD ALIGN="LEFT">IMG_RAD_11_background_systematics_w_chopper_SIM.py</TD><TD ALIGN="LEFT">IMG-RAD-11 background systematics with chopper simulations<BR ALIGN="LEFT"/>(STUB): load the scenario config and log what is still TBD;<BR ALIGN="LEFT"/>nothing is simulated…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">FITS case files (via sim_common)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  generate_background_systematics_sim -> stage_table [style=invis];
}

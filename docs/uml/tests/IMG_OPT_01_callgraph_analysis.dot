    tbd_warnings__stamp_all_saved_figures [label="stamp_all_saved_figures\nFrom now on in this process, stamp\nthe warning banner on every\nmatplotlib figure before it is\nsaved (Figure.s…", tooltip="From now on in this process, stamp the warning banner on every matplotlib figure\nbefore it is saved (Figure.savefig, which plt.savefig also calls). For scripts whose\nplots are made deep in shared modules.", shape=ellipse];

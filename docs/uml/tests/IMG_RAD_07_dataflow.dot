digraph dataflow {
  rankdir=LR;
  ranksep=0.9;
  nodesep=0.12;
  label="IMG-RAD-07 Photometric performance: data flow of the result fields (ANALYSIS)\nsolid blue = stage writes the field, dashed grey = stage reads it; italic = property (derived)";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  node [shape=box, style="rounded,filled", fillcolor="white", penwidth=1.5];
  ctor_PhotRunResult_backbone_img_rad_07_phot_populate_run [label="PhotRunResult(...)\n(in populate_run)"];
  IMG_RAD_07_photometric_performance_ANALYSIS_main [label="main", tooltip="Run the IMG-RAD-07 analysis for each data state (requirement, instrument,\ncase)."];
  backbone_img_rad_07_phot_reduce_flats [label="reduce_flats", tooltip="Reduce the run's flats (BCKGD_SUBTED) one at a time: the field mask from the\nbrightest (last) file, then per file the mean flux in the mask and its standard\nerror, and the block mean / standard error maps.\n\nOUTPUTS:\n- PhotRunResult, with exposure, flux, flux_sigma, block_means, block_sigmas"];
  backbone_img_rad_07_phot_plot_run [label="plot_run", tooltip="FYI plots in result.results_dir: METIS-2883 the B/mean - 1 block map; METIS-3300\nthe flux error per step (with the limit band) and the pattern-change map of the\nworst step; METIS-3291 S_empirical vs. S_perfect * alpha_fcn and the RSRF.\n\nOUTPUTS:\n- list[str]: written plot files"];
  backbone_img_rad_07_phot_log_test_outcome [label="log_test_outcome", tooltip="Log the outcome of the run's requirement (as decided by metis_2883_check or\nmetis_3300_check) and compare it with the injected truth (EXPECTED); a NOT\nEVALUATED verdict (METIS-2594, METIS-3291) is not compared.\n\nOUTPUTS:\n- PhotRunResult, with verdict_overall and consistent set"];
  backbone_img_rad_07_phot_log_summary [label="log_summary", tooltip="Log a table of all runs (requirement, instrument, case, verdict, expected,\nconsistency with the injected truth); METIS-2594 is NOT EVALUATED (no SIM data).\n\nOUTPUTS:\n- int: number of runs inconsistent with the injected truth"];
  subgraph cluster_PhotRunResult {
    label="PhotRunResult (backbone_img_rad_07_phot)";
    style=filled; fillcolor="#ece4f3"; color="#999999";
    f_run_name [label="run_name", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_req_id [label="req_id", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_instrument [label="instrument", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_case [label="case", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_file_names [label="file_names", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_headers [label="headers", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_results_dir [label="results_dir", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_limits [label="limits", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_analysis_cfg [label="analysis_cfg", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_exposure [label="exposure", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_flux [label="flux", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_flux_sigma [label="flux_sigma", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_block_means [label="block_means", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_block_sigmas [label="block_sigmas", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_measured [label="measured", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_sigma [label="sigma", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_verdicts [label="verdicts", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_rsrf [label="rsrf", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_verdict_overall [label="verdict_overall", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_consistent [label="consistent", shape=note, style=filled, fillcolor="white", penwidth=1];
  }
  ctor_PhotRunResult_backbone_img_rad_07_phot_populate_run -> f_run_name [color="#1f77b4"];
  ctor_PhotRunResult_backbone_img_rad_07_phot_populate_run -> f_req_id [color="#1f77b4"];
  ctor_PhotRunResult_backbone_img_rad_07_phot_populate_run -> f_instrument [color="#1f77b4"];
  ctor_PhotRunResult_backbone_img_rad_07_phot_populate_run -> f_case [color="#1f77b4"];
  ctor_PhotRunResult_backbone_img_rad_07_phot_populate_run -> f_file_names [color="#1f77b4"];
  ctor_PhotRunResult_backbone_img_rad_07_phot_populate_run -> f_headers [color="#1f77b4"];
  ctor_PhotRunResult_backbone_img_rad_07_phot_populate_run -> f_results_dir [color="#1f77b4"];
  ctor_PhotRunResult_backbone_img_rad_07_phot_populate_run -> f_limits [color="#1f77b4"];
  ctor_PhotRunResult_backbone_img_rad_07_phot_populate_run -> f_analysis_cfg [color="#1f77b4"];
  f_file_names -> IMG_RAD_07_photometric_performance_ANALYSIS_main [color="#888888", style=dashed];
  f_headers -> IMG_RAD_07_photometric_performance_ANALYSIS_main [color="#888888", style=dashed];
  f_req_id -> IMG_RAD_07_photometric_performance_ANALYSIS_main [color="#888888", style=dashed];
  backbone_img_rad_07_phot_reduce_flats -> f_flux [color="#1f77b4"];
  backbone_img_rad_07_phot_reduce_flats -> f_flux_sigma [color="#1f77b4"];
  backbone_img_rad_07_phot_reduce_flats -> f_exposure [color="#1f77b4"];
  f_analysis_cfg -> backbone_img_rad_07_phot_reduce_flats [color="#888888", style=dashed];
  f_file_names -> backbone_img_rad_07_phot_reduce_flats [color="#888888", style=dashed];
  f_run_name -> backbone_img_rad_07_phot_reduce_flats [color="#888888", style=dashed];
  f_block_means -> backbone_img_rad_07_phot_reduce_flats [color="#888888", style=dashed];
  f_block_sigmas -> backbone_img_rad_07_phot_reduce_flats [color="#888888", style=dashed];
  f_headers -> backbone_img_rad_07_phot_reduce_flats [color="#888888", style=dashed];
  f_results_dir -> backbone_img_rad_07_phot_plot_run [color="#888888", style=dashed];
  f_req_id -> backbone_img_rad_07_phot_plot_run [color="#888888", style=dashed];
  f_block_means -> backbone_img_rad_07_phot_plot_run [color="#888888", style=dashed];
  f_block_sigmas -> backbone_img_rad_07_phot_plot_run [color="#888888", style=dashed];
  f_run_name -> backbone_img_rad_07_phot_plot_run [color="#888888", style=dashed];
  f_measured -> backbone_img_rad_07_phot_plot_run [color="#888888", style=dashed];
  f_limits -> backbone_img_rad_07_phot_plot_run [color="#888888", style=dashed];
  f_flux -> backbone_img_rad_07_phot_plot_run [color="#888888", style=dashed];
  f_rsrf -> backbone_img_rad_07_phot_plot_run [color="#888888", style=dashed];
  backbone_img_rad_07_phot_log_test_outcome -> f_verdict_overall [color="#1f77b4"];
  backbone_img_rad_07_phot_log_test_outcome -> f_consistent [color="#1f77b4"];
  f_run_name -> backbone_img_rad_07_phot_log_test_outcome [color="#888888", style=dashed];
  f_req_id -> backbone_img_rad_07_phot_log_test_outcome [color="#888888", style=dashed];
  f_instrument -> backbone_img_rad_07_phot_log_test_outcome [color="#888888", style=dashed];
  f_case -> backbone_img_rad_07_phot_log_test_outcome [color="#888888", style=dashed];
  f_file_names -> backbone_img_rad_07_phot_log_test_outcome [color="#888888", style=dashed];
  f_measured -> backbone_img_rad_07_phot_log_test_outcome [color="#888888", style=dashed];
  f_sigma -> backbone_img_rad_07_phot_log_test_outcome [color="#888888", style=dashed];
  f_limits -> backbone_img_rad_07_phot_log_test_outcome [color="#888888", style=dashed];
  f_verdicts -> backbone_img_rad_07_phot_log_test_outcome [color="#888888", style=dashed];
  f_headers -> backbone_img_rad_07_phot_log_test_outcome [color="#888888", style=dashed];
  f_req_id -> backbone_img_rad_07_phot_log_summary [color="#888888", style=dashed];
  f_instrument -> backbone_img_rad_07_phot_log_summary [color="#888888", style=dashed];
  f_case -> backbone_img_rad_07_phot_log_summary [color="#888888", style=dashed];
  f_verdict_overall -> backbone_img_rad_07_phot_log_summary [color="#888888", style=dashed];
  f_headers -> backbone_img_rad_07_phot_log_summary [color="#888888", style=dashed];
  f_consistent -> backbone_img_rad_07_phot_log_summary [color="#888888", style=dashed];
}

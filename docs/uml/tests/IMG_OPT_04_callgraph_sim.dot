  ranksep=0.6;
  nodesep=0.15;
  label="IMG-OPT-04 Stray light: SIM call graph (IMG_OPT_04_METIS_AIT_img_stray_light_SIM.py)\nbox = @pipeline_stage, oval = helper, dashed box = class instantiated, dashed arrow = passed as callback; numbers = call order in main(); hover for the full docstring";

  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_IMG_OPT_04_METIS_AIT_img_stray_light_SIM {
    label="IMG_OPT_04_METIS_AIT_img_stray_light_SIM.py";
    style=filled; fillcolor="#f2f2f2"; color="#999999";
    IMG_OPT_04_METIS_AIT_img_stray_light_SIM__main [label="main\nGenerate IMG-OPT-04 stray-light\nsimulations, one set per\nrequirement, as set in the\nscenario config", tooltip="Generate IMG-OPT-04 stray-light simulations, one set per requirement, as set in the\nscenario config.", shape=box, style="filled,bold", fillcolor="white"];
    IMG_OPT_04_METIS_AIT_img_stray_light_SIM__simulate_metis_1189_1429 [label="simulate_metis_1189_1429\nSimulated data for METIS-1189 and\n-1429: stray light irradiance <\n0.04% of the peak irradiance", tooltip="Simulated data for METIS-1189 and -1429: stray light irradiance < 0.04% of the\npeak irradiance.\n\nPer case, the illuminated ScopeSim frame plus artefacts whose peak irradiance is\nthe injected fraction peak_frac of the PSF peak (the PSF peak from the signal,\nilluminated frame - dark_1).\n\nOUTPUTS:\n- list[str]: written files", shape=box, style="filled", fillcolor="white"];
    IMG_OPT_04_METIS_AIT_img_stray_light_SIM__simulate_metis_9522 [label="simulate_metis_9522\nSimulated data for METIS-9522: the\nflux of each artefact < 3-sigma of\nthe background noise for its\nspatial sc…", tooltip="Simulated data for METIS-9522: the flux of each artefact < 3-sigma of the\nbackground noise for its spatial scale.\n\nPer case, the illuminated ScopeSim frame plus artefacts each with total flux =\nflux_over_3sigma * 3 * sigma_pix * sqrt(area), where sigma_pix is the per-pixel\nnoise of a background-subtracted frame (std of dark_2 - dark_1).\n\nOUTPUTS:\n- list[str]: written files", shape=box, style="filled", fillcolor="white"];
    IMG_OPT_04_METIS_AIT_img_stray_light_SIM___truth_inputs [label="_truth_inputs\nDarks, illuminated frame, PSF peak\nand position, and the artefact\nlabels", tooltip="Darks, illuminated frame, PSF peak and position, and the artefact labels.", shape=ellipse];

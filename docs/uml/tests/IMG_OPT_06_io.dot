digraph io {
  rankdir=TB;
  ranksep=0.55;
  nodesep=0.2;
  label="IMG-OPT-06 Out-of-field stray light: SIM → ANALYSIS I/O map\ngold = config read, black = FITS written / read (edge labels: header cards), green = outputs";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_cfg {
    label="config/"; style=filled; fillcolor="#fff8dc"; color="#bbbbbb";
    y_config_file_IMG_04_stray_light_observing_yaml [label="config_file_IMG_04_stray_light_observing.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_06_out_of_field_observing_yaml [label="config_file_IMG_06_out_of_field_observing.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_OPT_06_outoffield_stray_light_SIM_yaml [label="config_file_IMG_OPT_06_outoffield_stray_light_SIM.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_common_observing_params_yaml [label="config_file_common_observing_params.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_OPT_06_out_of_field_data_states_yaml [label="config_file_IMG_OPT_06_out_of_field_data_states.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_06_out_of_field_coords_guesses_yaml [label="config_file_IMG_06_out_of_field_coords_guesses.yaml", shape=note, style=filled, fillcolor="white"];
  }
  subgraph cluster_IMG_OPT_06_METIS_AIT_out_of_field_SIM {
    label="IMG_OPT_06_METIS_AIT_out_of_field_SIM.py";
    style=filled; fillcolor="#eae1df"; color="#999999";
    IMG_OPT_06_METIS_AIT_out_of_field_SIM__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    IMG_OPT_06_METIS_AIT_out_of_field_SIM__simulate_metis_5838 [label="simulate_metis_5838\nSimulated data for METIS-5838:\nout-of-field irradiance attenuated\nby >= 1e4", shape=box, style="rounded,filled", fillcolor="white"];
    IMG_OPT_06_METIS_AIT_out_of_field_SIM__main -> IMG_OPT_06_METIS_AIT_out_of_field_SIM__simulate_metis_5838 [style=dashed];
  }
  fits [shape=record, style=filled, fillcolor="#e8f0fb", label="{data/IMG_OPT_06_out_of_field_simmed_data\n*.fits|<primary> PRIMARY header:\nATT_REQ ATT_INJ FOV_REQ OOF_DIR REF_PEAK REQ_ID CASE\nEXPECTED REQ_PLH SIMVER FILTER WCU_FP WCU_PP PSF_KERN\nND_FILT BB_TEMP NDIT DIT DIT_CFG SAT_ADU PEAKFRAC|{<x_BACKGROUND_2> BACKGROUND_2|<x_BCKGD_SUBTED> BCKGD_SUBTED|<x_RAW_READOUT> RAW_READOUT|<x_BACKGROUND> BACKGROUND}}"];
  IMG_OPT_06_METIS_AIT_out_of_field_SIM__simulate_metis_5838 -> fits;
  subgraph cluster_IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS {
    label="IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS.py + modules";
    style=filled; fillcolor="#f2f2f2"; color="#999999";
    IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
  }
  fits:x_BCKGD_SUBTED -> IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main;
  fits:x_BACKGROUND_2 -> IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main;
  fits:x_BACKGROUND -> IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main;
  fits:primary -> IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main [label="EXPECTED, ATT_INJ, REF_PEAK"];
  y_config_file_IMG_04_stray_light_observing_yaml -> IMG_OPT_06_METIS_AIT_out_of_field_SIM__main [color="#b8860b"];
  y_config_file_IMG_04_stray_light_observing_yaml -> IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_06_out_of_field_observing_yaml -> IMG_OPT_06_METIS_AIT_out_of_field_SIM__main [color="#b8860b"];
  y_config_file_IMG_06_out_of_field_observing_yaml -> IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_OPT_06_outoffield_stray_light_SIM_yaml -> IMG_OPT_06_METIS_AIT_out_of_field_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_06_METIS_AIT_out_of_field_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_OPT_06_out_of_field_data_states_yaml -> IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_06_out_of_field_coords_guesses_yaml -> IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main [color="#b8860b"];
  subgraph cluster_out {
    label="outputs"; style=filled; fillcolor="#e6f4e6"; color="#bbbbbb";
    o_logs_IMG_06_out_of_field_analysis_logs [label="logs/IMG_06_out_of_field_analysis_logs/", shape=folder, style=filled, fillcolor="white"];
    o_IMG_OPT_06_out_of_field_analysis_results [label="IMG_OPT_06_out_of_field_analysis_results/", shape=folder, style=filled, fillcolor="white"];
  }
  IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main -> o_logs_IMG_06_out_of_field_analysis_logs [color="#2ca02c"];
  IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS__main -> o_IMG_OPT_06_out_of_field_analysis_results [color="#2ca02c"];
}

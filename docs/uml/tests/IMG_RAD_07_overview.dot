digraph overview {
  rankdir=TB;
  ranksep=0.35;
  newrank=true;
  label="IMG-RAD-07 Photometric performance: overview\npipeline stages (this test's + the shared ones it uses), then each stage's purpose and the result fields it writes";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_flow {
    label="pipeline stages"; style=rounded; color="#999999";
    node [shape=box, style="rounded,filled"];
    generate_phot_performance_sim [label="Generate photometric-performance sims", fillcolor="#f2f2f2", style="rounded,filled"];
    img_rad_07_fyi_plots [label="FYI plots", fillcolor="#ece4f3", style="rounded,dashed,filled"];
    img_rad_07_log_test_outcome [label="IMG-RAD-07 pass/fail", fillcolor="#ece4f3", style="rounded,filled", penwidth=2];
    img_rad_07_metis_2594_check [label="METIS-2594: calibration flux range (stub)", fillcolor="#ece4f3", style="rounded,dashed,filled"];
    img_rad_07_metis_2883_check [label="METIS-2883: flat homogeneity", fillcolor="#ece4f3", style="rounded,filled"];
    img_rad_07_metis_3300_check [label="METIS-3300: 15 flux steps, flux and pattern", fillcolor="#ece4f3", style="rounded,filled"];
    simulate_metis_2594 [label="SIM METIS-2594: calibration flux range (stub)", fillcolor="#f2f2f2", style="rounded,dashed,filled"];
    simulate_metis_2883 [label="SIM METIS-2883: flat homogeneity", fillcolor="#f2f2f2", style="rounded,filled"];
    simulate_metis_3291 [label="SIM METIS-3291: RSRF precision", fillcolor="#f2f2f2", style="rounded,filled"];
    simulate_metis_3300 [label="SIM METIS-3300: 15 ND+DIT flux steps", fillcolor="#f2f2f2", style="rounded,filled"];
    simulate_metis_2594 -> generate_phot_performance_sim;
    simulate_metis_2883 -> generate_phot_performance_sim;
    simulate_metis_3300 -> generate_phot_performance_sim;
    img_rad_07_metis_2883_check -> img_rad_07_fyi_plots;
    img_rad_07_metis_3300_check -> img_rad_07_fyi_plots;
    img_rad_07_metis_2594_check -> img_rad_07_log_test_outcome;
    img_rad_07_metis_2883_check -> img_rad_07_log_test_outcome;
    img_rad_07_metis_3300_check -> img_rad_07_log_test_outcome;
    generate_phot_performance_sim -> img_rad_07_metis_2594_check;
    generate_phot_performance_sim -> img_rad_07_metis_2883_check;
    generate_phot_performance_sim -> img_rad_07_metis_3300_check;
  }
  stage_table [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dddddd"><B>stage</B></TD><TD BGCOLOR="#dddddd"><B>module</B></TD><TD BGCOLOR="#dddddd"><B>purpose (docstring)</B></TD><TD BGCOLOR="#dddddd"><B>writes</B></TD></TR><TR><TD ALIGN="LEFT">generate_phot_performance_sim</TD><TD ALIGN="LEFT">IMG_RAD_07_photometric_performance_SIM.py</TD><TD ALIGN="LEFT">Generate IMG-RAD-07 photometric performance simulations, one<BR ALIGN="LEFT"/>set per requirement, as set in the scenario config<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">STEP, N_STEPS, BB_APER, ND_TRANS,<BR ALIGN="LEFT"/>EXPOSURE, NOMFLUX, FLUXFAC, PATTAMP<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">simulate_metis_2594</TD><TD ALIGN="LEFT">IMG_RAD_07_photometric_performance_SIM.py</TD><TD ALIGN="LEFT">Stub for METIS-2594: METIS internal calibration shall<BR ALIGN="LEFT"/>provide a range of flux levels matching that encountered in<BR ALIGN="LEFT"/>scientific operation as d…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">FITS case files (via sim_common)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">simulate_metis_2883</TD><TD ALIGN="LEFT">IMG_RAD_07_photometric_performance_SIM.py</TD><TD ALIGN="LEFT">Simulated data for METIS-2883: the source used for detector<BR ALIGN="LEFT"/>linearity calibration shall provide an illumination that is<BR ALIGN="LEFT"/>spatially homogeneo…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">FITS case files (via sim_common)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">simulate_metis_3300</TD><TD ALIGN="LEFT">IMG_RAD_07_photometric_performance_SIM.py</TD><TD ALIGN="LEFT">Simulated data for METIS-3300: the level of flux of the flat<BR ALIGN="LEFT"/>field shall be tunable to 15 discrete values and shall be<BR ALIGN="LEFT"/>known at each step t…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">STEP, N_STEPS, BB_APER, ND_TRANS,<BR ALIGN="LEFT"/>EXPOSURE, NOMFLUX, FLUXFAC, PATTAMP<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">simulate_metis_3291</TD><TD ALIGN="LEFT">IMG_RAD_07_photometric_performance_SIM.py</TD><TD ALIGN="LEFT">Simulated data for METIS-3291: METIS shall allow the<BR ALIGN="LEFT"/>characterisation and correction of the relative spectral<BR ALIGN="LEFT"/>response function (RSRF) with…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">FITS case files (via sim_common)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">img_rad_07_fyi_plots</TD><TD ALIGN="LEFT">modules/backbone_img_rad_07_phot.py</TD><TD ALIGN="LEFT">FYI plots in result.results_dir: METIS-2883 the B/mean - 1<BR ALIGN="LEFT"/>block map; METIS-3300 the flux error per step (with the<BR ALIGN="LEFT"/>limit band) and the patt…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">img_rad_07_log_test_outcome</TD><TD ALIGN="LEFT">modules/backbone_img_rad_07_phot.py</TD><TD ALIGN="LEFT">Log the outcome of the run&#x27;s requirement (as decided by<BR ALIGN="LEFT"/>metis_2883_check or metis_3300_check) and compare it with<BR ALIGN="LEFT"/>the injected truth (EXPEC…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">verdict_overall, consistent<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  img_rad_07_fyi_plots -> stage_table [style=invis];
  img_rad_07_log_test_outcome -> stage_table [style=invis];
  simulate_metis_3291 -> stage_table [style=invis];
}

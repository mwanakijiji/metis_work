digraph overview {
  rankdir=TB;
  ranksep=0.35;
  newrank=true;
  label="IMG-OPT-05 Optomechanical stability: overview\npipeline stages (this test's + the shared ones it uses), then each stage's purpose and the result fields it writes";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_flow {
    label="pipeline stages"; style=rounded; color="#999999";
    node [shape=box, style="rounded,filled"];
    generate_optomechanical_stability_sim [label="Generate optomechanical-stability sims", fillcolor="#f2f2f2", style="rounded,filled"];
    img_opt_05_fyi_plots [label="FYI plots", fillcolor="#f3f3d7", style="rounded,dashed,filled"];
    img_opt_05_log_test_outcome [label="IMG-OPT-05 pass/fail", fillcolor="#f3f3d7", style="rounded,filled", penwidth=2];
    img_opt_05_measure_pupil_positions [label="Pupil-image centre per frame", fillcolor="#f3f3d7", style="rounded,filled"];
    img_opt_05_metis_5422_check [label="METIS-5422: RMS motion per timescale", fillcolor="#f3f3d7", style="rounded,filled"];
    simulate_metis_1230_flux_calibration [label="SIM METIS-1230: flux calibration interval (stub)", fillcolor="#f2f2f2", style="rounded,dashed,filled"];
    simulate_metis_5422_stability [label="SIM METIS-5422: pupil-image position stability per timescale", fillcolor="#f2f2f2", style="rounded,filled"];
    simulate_metis_1230_flux_calibration -> generate_optomechanical_stability_sim;
    simulate_metis_5422_stability -> generate_optomechanical_stability_sim;
    img_opt_05_metis_5422_check -> img_opt_05_fyi_plots;
    img_opt_05_metis_5422_check -> img_opt_05_log_test_outcome;
    generate_optomechanical_stability_sim -> img_opt_05_measure_pupil_positions;
    img_opt_05_measure_pupil_positions -> img_opt_05_metis_5422_check;
  }
  stage_table [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dddddd"><B>stage</B></TD><TD BGCOLOR="#dddddd"><B>module</B></TD><TD BGCOLOR="#dddddd"><B>purpose (docstring)</B></TD><TD BGCOLOR="#dddddd"><B>writes</B></TD></TR><TR><TD ALIGN="LEFT">generate_optomechanical_stability_sim</TD><TD ALIGN="LEFT">IMG_OPT_05_optomechanical_stability_SIM.py</TD><TD ALIGN="LEFT">IMG-OPT-05 optomechanical stability simulations, one set per<BR ALIGN="LEFT"/>requirement, as set in the scenario config (METIS-5422;<BR ALIGN="LEFT"/>METIS-1230 is a stub)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">TSCALE, LIMTYPE, FRAME, NFRAMES, T_REL,<BR ALIGN="LEFT"/>PUP_X, PUP_Y, SHIFT_X, SHIFT_Y,<BR ALIGN="LEFT"/>SHIFTMAS, PUPDIAM, PIXSCALE, PUPLEVEL,<BR ALIGN="LEFT"/>SEQ_RMS<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">simulate_metis_1230_flux_calibration</TD><TD ALIGN="LEFT">IMG_OPT_05_optomechanical_stability_SIM.py</TD><TD ALIGN="LEFT">Stub for METIS-1230 (on-sky flux calibration not more often<BR ALIGN="LEFT"/>than once per hour per instrument mode): writes nothing<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">FITS case files (via sim_common)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">simulate_metis_5422_stability</TD><TD ALIGN="LEFT">IMG_OPT_05_optomechanical_stability_SIM.py</TD><TD ALIGN="LEFT">Simulated data for METIS-5422 (position of the mask in CFO-<BR ALIGN="LEFT"/>FP2 stable w.r.t<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">TSCALE, LIMTYPE, FRAME, NFRAMES, T_REL,<BR ALIGN="LEFT"/>PUP_X, PUP_Y, SHIFT_X, SHIFT_Y,<BR ALIGN="LEFT"/>SHIFTMAS, PUPDIAM, PIXSCALE, PUPLEVEL,<BR ALIGN="LEFT"/>SEQ_RMS<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">img_opt_05_measure_pupil_positions</TD><TD ALIGN="LEFT">modules/backbone_img_opt_05_optomech_stability.py</TD><TD ALIGN="LEFT">Measure the pupil centre (pupil_centre) of each frame of the<BR ALIGN="LEFT"/>run (BCKGD_SUBTED), one frame at a time, and the frame times<BR ALIGN="LEFT"/>(DATE-OBS)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">centres, centre_sigmas, radii, times<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">img_opt_05_fyi_plots</TD><TD ALIGN="LEFT">modules/backbone_img_opt_05_optomech_stability.py</TD><TD ALIGN="LEFT">FYI plot in result.results_dir: the measured pupil offsets<BR ALIGN="LEFT"/>(mas on sky) vs<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">img_opt_05_log_test_outcome</TD><TD ALIGN="LEFT">modules/backbone_img_opt_05_optomech_stability.py</TD><TD ALIGN="LEFT">Log the outcome of the run&#x27;s requirement (as decided by<BR ALIGN="LEFT"/>metis_5422_check) and compare it with the injected truth<BR ALIGN="LEFT"/>(EXPECTED)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">verdict_overall, consistent<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  img_opt_05_fyi_plots -> stage_table [style=invis];
  img_opt_05_log_test_outcome -> stage_table [style=invis];
}

digraph io {
  rankdir=TB;
  ranksep=0.55;
  nodesep=0.2;
  label="IMG-OPT-04 Stray light: SIM → ANALYSIS I/O map\ngold = config read, black = FITS written / read (edge labels: header cards), green = outputs";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_cfg {
    label="config/"; style=filled; fillcolor="#fff8dc"; color="#bbbbbb";
    y_config_file_IMG_04_stray_light_observing_yaml [label="config_file_IMG_04_stray_light_observing.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_OPT_04_stray_light_SIM_yaml [label="config_file_IMG_OPT_04_stray_light_SIM.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_common_observing_params_yaml [label="config_file_common_observing_params.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_OPT_04_stray_light_data_states_yaml [label="config_file_IMG_OPT_04_stray_light_data_states.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_04_stray_light_coords_guesses_yaml [label="config_file_IMG_04_stray_light_coords_guesses.yaml", shape=note, style=filled, fillcolor="white"];
  }
  subgraph cluster_IMG_OPT_04_METIS_AIT_img_stray_light_SIM {
    label="IMG_OPT_04_METIS_AIT_img_stray_light_SIM.py";
    style=filled; fillcolor="#f8d8d8"; color="#999999";
    IMG_OPT_04_METIS_AIT_img_stray_light_SIM__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    IMG_OPT_04_METIS_AIT_img_stray_light_SIM__simulate_metis_1189_1429 [label="simulate_metis_1189_1429\nSimulated data for METIS-1189 and\n-1429: stray light irradiance <\n0.04% of the peak irradiance", shape=box, style="rounded,filled", fillcolor="white"];
    IMG_OPT_04_METIS_AIT_img_stray_light_SIM__main -> IMG_OPT_04_METIS_AIT_img_stray_light_SIM__simulate_metis_1189_1429 [style=dashed];
    IMG_OPT_04_METIS_AIT_img_stray_light_SIM__simulate_metis_9522 [label="simulate_metis_9522\nSimulated data for METIS-9522: the\nflux of each artefact < 3-sigma of\nthe background noise for its\nspatial sc…", shape=box, style="rounded,filled", fillcolor="white"];
    IMG_OPT_04_METIS_AIT_img_stray_light_SIM__main -> IMG_OPT_04_METIS_AIT_img_stray_light_SIM__simulate_metis_9522 [style=dashed];
  }
  fits [shape=record, style=filled, fillcolor="#e8f0fb", label="{data/IMG_OPT_04_stray_light_simmed_data\n*.fits|<primary> PRIMARY header:\nN_ART ART_PEAK REF_PEAK SIG_PIX REQ_ID CASE EXPECTED REQ_PLH\nSIMVER FILTER WCU_FP WCU_PP PSF_KERN ND_FILT BB_TEMP NDIT\nDIT DIT_CFG SAT_ADU PEAKFRAC|{<x_TRUTH_LABELS> TRUTH_LABELS|<x_BCKGD_SUBTED> BCKGD_SUBTED|<x_RAW_READOUT> RAW_READOUT|<x_BACKGROUND> BACKGROUND}}"];
  IMG_OPT_04_METIS_AIT_img_stray_light_SIM__simulate_metis_1189_1429 -> fits;
  IMG_OPT_04_METIS_AIT_img_stray_light_SIM__simulate_metis_9522 -> fits;
  subgraph cluster_IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS {
    label="IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS.py + modules";
    style=filled; fillcolor="#f2f2f2"; color="#999999";
    IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
  }
  fits:x_BCKGD_SUBTED -> IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS__main;
  fits:primary -> IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS__main [label="REQ_ID, CASE, REQ_QTY, INJ_VAL, EXPECTED"];
  y_config_file_IMG_04_stray_light_observing_yaml -> IMG_OPT_04_METIS_AIT_img_stray_light_SIM__main [color="#b8860b"];
  y_config_file_IMG_04_stray_light_observing_yaml -> IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_OPT_04_stray_light_SIM_yaml -> IMG_OPT_04_METIS_AIT_img_stray_light_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_04_METIS_AIT_img_stray_light_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_OPT_04_stray_light_data_states_yaml -> IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_04_stray_light_coords_guesses_yaml -> IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS__main [color="#b8860b"];
  subgraph cluster_out {
    label="outputs"; style=filled; fillcolor="#e6f4e6"; color="#bbbbbb";
    o_logs_IMG_04_stray_light_analysis_logs [label="logs/IMG_04_stray_light_analysis_logs/", shape=folder, style=filled, fillcolor="white"];
    o_IMG_OPT_04_stray_light_analysis_results [label="IMG_OPT_04_stray_light_analysis_results/", shape=folder, style=filled, fillcolor="white"];
  }
  IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS__main -> o_logs_IMG_04_stray_light_analysis_logs [color="#2ca02c"];
  IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS__main -> o_IMG_OPT_04_stray_light_analysis_results [color="#2ca02c"];
}

digraph overview {
  rankdir=TB;
  ranksep=0.35;
  newrank=true;
  label="IMG-OPT-03 PSF quality: overview\npipeline stages (this test's + the shared ones it uses), then each stage's purpose and the result fields it writes";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_flow {
    label="pipeline stages"; style=rounded; color="#999999";
    node [shape=box, style="rounded,filled"];
    collect_strehls [label="Collect Strehl over FOV", fillcolor="#d9eed9", style="rounded,filled"];
    generate_psf_quality_sim [label="Generate PSF-quality sims", fillcolor="#f2f2f2", style="rounded,filled"];
    img_03_metis_1408_1409_check [label="METIS-1408/-1409: Strehl >= 0.8 over FOV", fillcolor="#d9eed9", style="rounded,filled"];
    img_03_metis_2864_check [label="METIS-2864: Strehl > 0.8, WCU+CFO+IMG-LM path", fillcolor="#d9eed9", style="rounded,filled"];
    img_03_metis_3503_check [label="METIS-3503: PSF characterised across FoV", fillcolor="#d9eed9", style="rounded,filled"];
    img_03_test_outcome [label="IMG-OPT-03 pass/fail", fillcolor="#d9eed9", style="rounded,filled", penwidth=2];
    plot_strehl_fov [label="FYI plots", fillcolor="#d9eed9", style="rounded,dashed,filled"];
    prepare_psf_grid [label="Load frame, 1st-pass centroids", fillcolor="#d9eed9", style="rounded,filled"];
    process_one_psf [label="Fit one PSF", fillcolor="#d9eed9", style="rounded,filled"];
    sim_img_03_strehl_cases [label="SIM METIS-1408/-1409/-2864: Strehl cases", fillcolor="#f2f2f2", style="rounded,filled"];
    process_one_psf -> collect_strehls;
    sim_img_03_strehl_cases -> generate_psf_quality_sim;
    collect_strehls -> img_03_metis_1408_1409_check;
    collect_strehls -> img_03_metis_2864_check;
    collect_strehls -> img_03_metis_3503_check;
    img_03_metis_1408_1409_check -> img_03_test_outcome;
    img_03_metis_2864_check -> img_03_test_outcome;
    img_03_metis_3503_check -> img_03_test_outcome;
    collect_strehls -> plot_strehl_fov;
    generate_psf_quality_sim -> prepare_psf_grid;
    prepare_psf_grid -> process_one_psf;
  }
  stage_table [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dddddd"><B>stage</B></TD><TD BGCOLOR="#dddddd"><B>module</B></TD><TD BGCOLOR="#dddddd"><B>purpose (docstring)</B></TD><TD BGCOLOR="#dddddd"><B>writes</B></TD></TR><TR><TD ALIGN="LEFT">generate_psf_quality_sim</TD><TD ALIGN="LEFT">IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM.py</TD><TD ALIGN="LEFT">Generate IMG-OPT-03 PSF image quality simulations, one set<BR ALIGN="LEFT"/>per requirement, as set in the scenario config<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">STREHREF, HALO_SIG, HALO_S<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">sim_img_03_strehl_cases</TD><TD ALIGN="LEFT">IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM.py</TD><TD ALIGN="LEFT">Simulated data for a Strehl requirement (METIS-1408/-1409,<BR ALIGN="LEFT"/>METIS-2864: Strehl &gt;= 0.8)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">STREHREF, HALO_SIG, HALO_S<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">prepare_psf_grid</TD><TD ALIGN="LEFT">modules/backbone_img_03_psf_quality.py</TD><TD ALIGN="LEFT">Load a FITS file with a grid of PSFs, resolve the mask-<BR ALIGN="LEFT"/>dependent observing config, and find the 1st-pass centroids<BR ALIGN="LEFT"/>of the PSFs<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">process_one_psf</TD><TD ALIGN="LEFT">modules/backbone_img_03_psf_quality.py</TD><TD ALIGN="LEFT">Process one PSF cutout by oversampling it, centroiding it<BR ALIGN="LEFT"/>with a Gaussian fit, and optionally evaluating additional<BR ALIGN="LEFT"/>Strehl estimators<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">collect_strehls</TD><TD ALIGN="LEFT">modules/backbone_img_03_psf_quality.py</TD><TD ALIGN="LEFT">Gather the per-PSF fit results (in the order of the 1st-pass<BR ALIGN="LEFT"/>centroids) into one result for the file<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">plot_strehl_fov</TD><TD ALIGN="LEFT">modules/backbone_img_03_psf_quality.py</TD><TD ALIGN="LEFT">FYI plots on the detector frame: the Strehl of each PSF, and<BR ALIGN="LEFT"/>the Strehl from all methods for one randomly chosen PSF.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">img_03_metis_1408_1409_check</TD><TD ALIGN="LEFT">modules/backbone_img_03_psf_quality.py</TD><TD ALIGN="LEFT">Decide METIS-1408 (Strehl &gt;= 80% at lambda &gt; 3 um in all<BR ALIGN="LEFT"/>modes over the entire FOV) and METIS-1409 (Strehl &gt; 0.8 at 3<BR ALIGN="LEFT"/>um for IMG-LM and -NQ…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">img_03_metis_2864_check</TD><TD ALIGN="LEFT">modules/backbone_img_03_psf_quality.py</TD><TD ALIGN="LEFT">Decide METIS-2864 (minimum Strehl of the WCU+CFO+IMG-LM<BR ALIGN="LEFT"/>optical path &gt; 80% at 3.3 um over the entire FOV): the same<BR ALIGN="LEFT"/>Strehl criterion as met…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">img_03_metis_3503_check</TD><TD ALIGN="LEFT">modules/backbone_img_03_psf_quality.py</TD><TD ALIGN="LEFT">Decide METIS-3503 (the shape of the instrument PSF can be<BR ALIGN="LEFT"/>characterised across the entire FoV using the WCU): PASS if<BR ALIGN="LEFT"/>every PSF in the grid…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">img_03_test_outcome</TD><TD ALIGN="LEFT">modules/backbone_img_03_psf_quality.py</TD><TD ALIGN="LEFT">Log the outcome of each IMG-OPT-03 requirement (as decided<BR ALIGN="LEFT"/>by metis_1408_1409_check, metis_2864_check and<BR ALIGN="LEFT"/>metis_3503_check) and of the whol…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">verdict_overall<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  img_03_test_outcome -> stage_table [style=invis];
  plot_strehl_fov -> stage_table [style=invis];
}

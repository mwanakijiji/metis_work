  IMG_OPT_06_METIS_AIT_out_of_field_SIM__main -> config_common__load_observing_config [label="4"];
  IMG_OPT_06_METIS_AIT_out_of_field_SIM__main -> helpers__load_config_and_pipe [label="5"];

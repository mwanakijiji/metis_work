digraph io {
  rankdir=TB;
  ranksep=0.55;
  nodesep=0.2;
  label="IMG-OPT-02 Distortion (need distortion info): SIM → ANALYSIS I/O map\ngold = config read, black = FITS written / read (edge labels: header cards), green = outputs";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_cfg {
    label="config/"; style=filled; fillcolor="#fff8dc"; color="#bbbbbb";
    y_config_file_IMG_OPT_02_distortion_SIM_yaml [label="config_file_IMG_OPT_02_distortion_SIM.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_common_observing_params_yaml [label="config_file_common_observing_params.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_02_strehl_runs_yaml [label="config_file_IMG_02_strehl_runs.yaml", shape=note, style=filled, fillcolor="white"];
  }
  subgraph cluster_IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM {
    label="IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM.py";
    style=filled; fillcolor="#ffe8d4"; color="#999999";
    IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM__simulate_grid_frames [label="simulate_grid_frames\nUnmodified pinhole-grid frame of\none WCU set-up (no distortion\ninjected yet), as\nIMG_OPT_02_<req_key>_<instru…", shape=box, style="rounded,filled", fillcolor="white"];
    IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM__main -> IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM__simulate_grid_frames [style=dashed];
  }
  fits [shape=record, style=filled, fillcolor="#e8f0fb", label="{data/IMG_OPT_02_distortion_simmed_data\n*.fits|<primary> PRIMARY header:\nREQ_ID CASE SIMVER FILTER WCU_FP WCU_PP PSF_KERN ND_FILT\nBB_TEMP NDIT DIT DIT_CFG SAT_ADU PEAKFRAC|{<x_BCKGD_SUBTED> BCKGD_SUBTED|<x_RAW_READOUT> RAW_READOUT|<x_BACKGROUND> BACKGROUND}}"];
  IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM__simulate_grid_frames -> fits;
  subgraph cluster_IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS {
    label="IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS.py + modules";
    style=filled; fillcolor="#f2f2f2"; color="#999999";
    IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
  }
  y_config_file_IMG_OPT_02_distortion_SIM_yaml -> IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_02_strehl_runs_yaml -> IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS__main [color="#b8860b"];
  subgraph cluster_out {
    label="outputs"; style=filled; fillcolor="#e6f4e6"; color="#bbbbbb";
    o_logs_IMG_02_logs [label="logs/IMG_02_logs/", shape=folder, style=filled, fillcolor="white"];
  }
  IMG_OPT_02_METIS_AIT_img_cal_distortion_ANALYSIS__main -> o_logs_IMG_02_logs [color="#2ca02c"];
}

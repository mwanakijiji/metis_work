digraph overview {
  rankdir=TB;
  ranksep=0.35;
  newrank=true;
  label="IMG-RAD-09 Nominal background behaviour: overview\npipeline stages (this test's + the shared ones it uses), then each stage's purpose and the result fields it writes";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_flow {
    label="pipeline stages"; style=rounded; color="#999999";
    node [shape=box, style="rounded,filled"];
    generate_nominal_background_sim [label="Generate nominal background sims", fillcolor="#f2f2f2", style="rounded,filled"];
    img_rad_09_fyi_plots [label="FYI plots", fillcolor="#fae7f4", style="rounded,dashed,filled"];
    img_rad_09_sens_10000s_check [label="Point-source sensitivity in 10000 s: noise vs. limit", fillcolor="#fae7f4", style="rounded,filled"];
    img_rad_09_test_outcome [label="IMG-RAD-09 pass/fail", fillcolor="#fae7f4", style="rounded,filled", penwidth=2];
    simulate_rad_09_sensitivity [label="SIM 10000 s WCU flat: point-source noise", fillcolor="#f2f2f2", style="rounded,filled"];
    simulate_rad_09_sensitivity -> generate_nominal_background_sim;
    img_rad_09_sens_10000s_check -> img_rad_09_fyi_plots;
    generate_nominal_background_sim -> img_rad_09_sens_10000s_check;
    img_rad_09_sens_10000s_check -> img_rad_09_test_outcome;
  }
  stage_table [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dddddd"><B>stage</B></TD><TD BGCOLOR="#dddddd"><B>module</B></TD><TD BGCOLOR="#dddddd"><B>purpose (docstring)</B></TD><TD BGCOLOR="#dddddd"><B>writes</B></TD></TR><TR><TD ALIGN="LEFT">generate_nominal_background_sim</TD><TD ALIGN="LEFT">IMG_RAD_09_nominal_background_behavior_SIM.py</TD><TD ALIGN="LEFT">Generate IMG-RAD-09 nominal background simulations, one set<BR ALIGN="LEFT"/>per requirement and instrument, as set in the scenario<BR ALIGN="LEFT"/>config<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">TARGET, EXPTIME, NEXP, AP_RAD, N_APER,<BR ALIGN="LEFT"/>FLUXCAL, FLUXPLH, NAT_NOIS, NOISFAC<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">simulate_rad_09_sensitivity</TD><TD ALIGN="LEFT">IMG_RAD_09_nominal_background_behavior_SIM.py</TD><TD ALIGN="LEFT">Simulated data for the point-source sensitivity in a 10000 s<BR ALIGN="LEFT"/>exposure: two independent long WCU flat exposures A and B<BR ALIGN="LEFT"/>(total_exptime_s eac…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">TARGET, EXPTIME, NEXP, AP_RAD, N_APER,<BR ALIGN="LEFT"/>FLUXCAL, FLUXPLH, NAT_NOIS, NOISFAC<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">img_rad_09_fyi_plots</TD><TD ALIGN="LEFT">modules/backbone_img_rad_09_nom.py</TD><TD ALIGN="LEFT">FYI plot in result.results_dir: histogram of the aperture<BR ALIGN="LEFT"/>sums (flux units) with the Gaussian of the measured noise<BR ALIGN="LEFT"/>and +/- the limit<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">img_rad_09_test_outcome</TD><TD ALIGN="LEFT">modules/backbone_img_rad_09_nom.py</TD><TD ALIGN="LEFT">Log the outcome of the run&#x27;s requirement and compare it with<BR ALIGN="LEFT"/>the injected truth (EXPECTED)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">verdict_overall, consistent<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  img_rad_09_fyi_plots -> stage_table [style=invis];
  img_rad_09_test_outcome -> stage_table [style=invis];
}

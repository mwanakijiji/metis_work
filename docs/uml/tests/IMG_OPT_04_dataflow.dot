digraph dataflow {
  rankdir=LR;
  ranksep=0.9;
  nodesep=0.12;
  label="IMG-OPT-04 Stray light: data flow of the result fields (ANALYSIS)\nsolid blue = stage writes the field, dashed grey = stage reads it; italic = property (derived)";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  node [shape=box, style="rounded,filled", fillcolor="white", penwidth=1.5];
  ctor_StrayLightResult_IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS_main [label="StrayLightResult(...)\n(in main)"];
  stray_light_common_populate_result_obj_info [label="populate_result_obj_info", tooltip="Populate the result object with information from the data state.\n\nINPUTS:\n- result_obj (StrayLightResult): result object\n- data_state (dict): data state\n- observing_config (ObservingConfig): observing config\n\nOUTPUTS:\n- result_obj (StrayLightResult): result object"];
  stray_light_common_centroid_2passes_oversample [label="centroid_2passes_oversample", tooltip="Centroid the PSF in the image of the result object, starting from first guesses of\nthe positions. This uses 2 passes for accuracy.\n\nINPUTS:\n- result_obj: result object\n- config_coords_guesses_file_name: path to the config file with the coordinates\n  guesses\n- psfs_subset: subset of PSFs to use, \"all\" or an int\n- oversample_factor: oversample factor\n- grid_header: header of the grid\n- centroid_box_size: size of the centroid box\n- zoom_order: order of the zoom\n- centroid_func: function to use for centroiding\n- centroid_sources_impl: implementation of the centroid_sources function\n\nOUTPUTS:\n- result_obj, with centroids set (2nd-pass centroid dict, see\n  psf_grid_prep.refine_2nd_pass_centroids)"];
  stray_light_common_stray_light_mask_real [label="stray_light_mask_real", tooltip="Mask the real PSF, so we can find the stray light.\n\nThe mask is everything within psf_mask_n_lambda_over_d * lambda/D of the PSF\ncentroid, with psf_mask_n_lambda_over_d set in the observing config.\n\nINPUTS:\n- result_obj (StrayLightResult): result object\n- observing_config (ObservingConfig): observing config\n\nOUTPUTS:\n- result_obj, with real_psf_mask set"];
  stray_light_common_stray_light_segmentation_combined [label="stray_light_segmentation_combined", tooltip="Segment the stray light with a weighted combination of the methods in\nSEGMENTATION_METHODS.\n\nEach method with weight > 0 is run on the same denoised frame. Regions that overlap\nacross methods\nget the same label (see _combine_method_regions). A pixel is finally counted as\nstray light if\nΣ' > N * Σ, where Σ' is the summed weight of the methods detecting that pixel, Σ is\nthe sum of all\nweights, and N = vote_fraction.\n\nINPUTS:\n- result_obj: result object (needs image and real_psf_mask)\n- weights: {method: weight in [0, 1]}; methods left out get weight 1, weight 0 skips\n  a method.\n    If None, uses result_obj.segmentation_weights (e.g. from the data state), else\n    all 1.\n- vote_fraction: N in [0, 1]. If None, uses result_obj.segmentation_vote_fraction,\n    else SEGMENTATION_DEFAULT_VOTE_FRACTION\n- params: {method: {knob: value}} overriding SEGMENTATION_DEFAULT_PARAMS[method]; if\n  None,\n    uses result_obj.segmentation_params if set\n\nOUTPUTS:\n- result_obj (StrayLightResult), updated attributes:\n    - segment_map (np.ndarray[int32]): group labels of the final regions (0 = not\n      stray light)\n    - segmentation_method (str): 'combined'\n    - segmentation_weights, segmentation_vote_fraction: as used\n    - method_label_maps (dict): per method, group labels of its detections\n    - final_label_map (np.ndarray): group labels of the final regions (same as\n      segment_map)\n- FYI plots and FITS file in the result object's results_dir\n  (stray_light_segmentation_*_<stem>.png, stray_light_segmentation_combined_<stem>\n  .png/.fits)"];
  stray_light_common_stray_light_segmentation [label="stray_light_segmentation", tooltip="Segment the stray light.\n\nIdeas and methods herein are from Eric Pantin's notebook for instructional purposes\n(dev_notebooks/TP_image_segmentation.ipynb). Many knobs remain to be tuned with real\ndata.\n\nINPUTS:\n- result_obj: result object (needs image and real_psf_mask)\n- method: segmentation method; one of SEGMENTATION_METHODS:\n    - 'threshold': global threshold (otsu/mean/median) of the denoised image, then\n      connected components\n    - 'hough_circle': circles fitted to bright blobs; each region is a filled circle\n    - 'active_contour': as 'hough_circle', but each circle is refined with an active\n      contour (snake)\n        and dilated by expand_px\n    - 'watershed': thresholded foreground split into touching blobs by\n      distance-transform seeds + watershed\n    - 'kmeans': k-means clustering of pixel intensities; the brightest cluster(s)\n      are stray light\n    - 'meanshift': mean-shift filtering, then an Otsu threshold of the filtered\n      image\n  If None, uses result_obj.segmentation_method (e.g. from the data state), else\n  'active_contour'.\n- params: dict overriding SEGMENTATION_DEFAULT_PARAMS[method]; if None, uses\n    result_obj.segmentation_params if set\n\nOUTPUTS:\n- result_obj (StrayLightResult), updated attributes:\n    - segment_map (np.ndarray[int32]): integer region labels (0 = not stray light),\n      regions labelled 1..n\n    - segmentation_method (str): the method used\n- FYI plot in the result object's results_dir"];
  backbone_img_opt_04_stray_light_stray_light_brightness_spectrum [label="stray_light_brightness_spectrum", tooltip="Sort out the segments into brightnesses as function of spatial scales, and measure\nthe quantities the requirements are tested against (pass/fail itself is decided in\nmetis_1189_1429_check and metis_9522_check).\n\nINPUTS:\n- result_obj: result object, which should contain\n    - image (ndarray): science image\n    - segment_map (ndarray[int]): integer region labels (0 = not stray light)\n- observing_config: observing config\n\n\nOUTPUTS:\n- result_obj (StrayLightResult), updated attributes:\n    - regions (list[StrayLightRegion]): flux statistics and METIS-9522 limit of\n      each region\n    - psf_max (float): peak of the real PSF\n    - background_rms (float): per-pixel rms outside the PSF and the regions"];
  backbone_img_opt_04_stray_light_metis_1189_1429_check [label="metis_1189_1429_check", tooltip="Decide METIS-1189 (stray light < 0.1% of the peak irradiance in the IMG focal\nplanes) and METIS-1429 (< 0.04% in the IMG-LM and IMG-N detector planes): the peak\nirradiance of every stray light region is below METIS_1189_1429_PEAK_FRAC (the\nstricter 0.04%) of the PSF peak. No stray light regions: PASS.\n\nINPUTS:\n- result_obj (StrayLightResult): from stray_light_brightness_spectrum (regions,\n  psf_max)\n\nOUTPUTS:\n- result_obj (StrayLightResult), with pass_metis_1189_1429 set"];
  backbone_img_opt_04_stray_light_metis_9522_check [label="metis_9522_check", tooltip="Decide METIS-9522: the total flux of every stray light region is below 3-sigma of\nthe background noise of the summed flux over the region's area (i.e. for its\nspatial scale; StrayLightRegion.metis_9522_limit). No stray light regions: PASS.\n\nINPUTS:\n- result_obj (StrayLightResult): from stray_light_brightness_spectrum (regions,\n  with metis_9522_limit)\n\nOUTPUTS:\n- result_obj (StrayLightResult), with pass_metis_9522 set"];
  backbone_img_opt_04_stray_light_log_test_outcome [label="log_test_outcome", tooltip="Log the outcome of each IMG-OPT-04 requirement (as decided by metis_1189_1429_check\nand metis_9522_check) and of the whole test: PASS if both pass, else FAIL.\n\nINPUTS:\n- result_obj (StrayLightResult): with pass_metis_1189_1429 and pass_metis_9522 set\n\nOUTPUTS:\n- result_obj (StrayLightResult), with verdict_overall set"];
  subgraph cluster_StrayLightResult {
    label="StrayLightResult (stray_light_common)";
    style=filled; fillcolor="#fde3e3"; color="#999999";
    f_file_absname [label="file_absname", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_filter_name [label="filter_name", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_detector [label="detector", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_image [label="image", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_results_dir [label="results_dir", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_wavel_central [label="wavel_central", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_pixel_scale [label="pixel_scale", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_real_psf_mask [label="real_psf_mask", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_segment_map [label="segment_map", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_segmentation_method [label="segmentation_method", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_segmentation_weights [label="segmentation_weights", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_segmentation_vote_fraction [label="segmentation_vote_fraction", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_method_label_maps [label="method_label_maps", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_final_label_map [label="final_label_map", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_centroids [label="centroids", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_regions [label="regions", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_background_rms [label="background_rms", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_psf_max [label="psf_max", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_pass_metis_1189_1429 [label="pass_metis_1189_1429", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_pass_metis_9522 [label="pass_metis_9522", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_verdict_overall [label="verdict_overall", shape=note, style=filled, fillcolor="white", penwidth=1];
  }
  ctor_StrayLightResult_IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS_main -> f_file_absname [color="#1f77b4"];
  ctor_StrayLightResult_IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS_main -> f_filter_name [color="#1f77b4"];
  ctor_StrayLightResult_IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS_main -> f_detector [color="#1f77b4"];
  ctor_StrayLightResult_IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS_main -> f_image [color="#1f77b4"];
  ctor_StrayLightResult_IMG_OPT_04_METIS_AIT_img_stray_light_ANALYSIS_main -> f_results_dir [color="#1f77b4"];
  stray_light_common_populate_result_obj_info -> f_wavel_central [color="#1f77b4"];
  stray_light_common_populate_result_obj_info -> f_pixel_scale [color="#1f77b4"];
  f_detector -> stray_light_common_populate_result_obj_info [color="#888888", style=dashed];
  f_filter_name -> stray_light_common_populate_result_obj_info [color="#888888", style=dashed];
  stray_light_common_centroid_2passes_oversample -> f_centroids [color="#1f77b4"];
  f_image -> stray_light_common_centroid_2passes_oversample [color="#888888", style=dashed];
  stray_light_common_stray_light_mask_real -> f_real_psf_mask [color="#1f77b4"];
  f_wavel_central -> stray_light_common_stray_light_mask_real [color="#888888", style=dashed];
  f_image -> stray_light_common_stray_light_mask_real [color="#888888", style=dashed];
  f_centroids -> stray_light_common_stray_light_mask_real [color="#888888", style=dashed];
  f_pixel_scale -> stray_light_common_stray_light_mask_real [color="#888888", style=dashed];
  stray_light_common_stray_light_segmentation_combined -> f_segment_map [color="#1f77b4"];
  stray_light_common_stray_light_segmentation_combined -> f_segmentation_method [color="#1f77b4"];
  stray_light_common_stray_light_segmentation_combined -> f_segmentation_weights [color="#1f77b4"];
  stray_light_common_stray_light_segmentation_combined -> f_segmentation_vote_fraction [color="#1f77b4"];
  stray_light_common_stray_light_segmentation_combined -> f_method_label_maps [color="#1f77b4"];
  stray_light_common_stray_light_segmentation_combined -> f_final_label_map [color="#1f77b4"];
  f_image -> stray_light_common_stray_light_segmentation_combined [color="#888888", style=dashed];
  f_real_psf_mask -> stray_light_common_stray_light_segmentation_combined [color="#888888", style=dashed];
  f_file_absname -> stray_light_common_stray_light_segmentation_combined [color="#888888", style=dashed];
  f_filter_name -> stray_light_common_stray_light_segmentation_combined [color="#888888", style=dashed];
  f_detector -> stray_light_common_stray_light_segmentation_combined [color="#888888", style=dashed];
  stray_light_common_stray_light_segmentation -> f_segment_map [color="#1f77b4"];
  stray_light_common_stray_light_segmentation -> f_segmentation_method [color="#1f77b4"];
  f_real_psf_mask -> stray_light_common_stray_light_segmentation [color="#888888", style=dashed];
  f_image -> stray_light_common_stray_light_segmentation [color="#888888", style=dashed];
  f_file_absname -> stray_light_common_stray_light_segmentation [color="#888888", style=dashed];
  backbone_img_opt_04_stray_light_stray_light_brightness_spectrum -> f_regions [color="#1f77b4"];
  backbone_img_opt_04_stray_light_stray_light_brightness_spectrum -> f_background_rms [color="#1f77b4"];
  backbone_img_opt_04_stray_light_stray_light_brightness_spectrum -> f_psf_max [color="#1f77b4"];
  f_image -> backbone_img_opt_04_stray_light_stray_light_brightness_spectrum [color="#888888", style=dashed];
  f_segment_map -> backbone_img_opt_04_stray_light_stray_light_brightness_spectrum [color="#888888", style=dashed];
  f_real_psf_mask -> backbone_img_opt_04_stray_light_stray_light_brightness_spectrum [color="#888888", style=dashed];
  f_segmentation_method -> backbone_img_opt_04_stray_light_stray_light_brightness_spectrum [color="#888888", style=dashed];
  backbone_img_opt_04_stray_light_metis_1189_1429_check -> f_pass_metis_1189_1429 [color="#1f77b4"];
  f_regions -> backbone_img_opt_04_stray_light_metis_1189_1429_check [color="#888888", style=dashed];
  f_psf_max -> backbone_img_opt_04_stray_light_metis_1189_1429_check [color="#888888", style=dashed];
  backbone_img_opt_04_stray_light_metis_9522_check -> f_pass_metis_9522 [color="#1f77b4"];
  f_regions -> backbone_img_opt_04_stray_light_metis_9522_check [color="#888888", style=dashed];
  backbone_img_opt_04_stray_light_log_test_outcome -> f_verdict_overall [color="#1f77b4"];
  f_pass_metis_1189_1429 -> backbone_img_opt_04_stray_light_log_test_outcome [color="#888888", style=dashed];
  f_pass_metis_9522 -> backbone_img_opt_04_stray_light_log_test_outcome [color="#888888", style=dashed];
  f_file_absname -> backbone_img_opt_04_stray_light_log_test_outcome [color="#888888", style=dashed];
  f_regions -> backbone_img_opt_04_stray_light_log_test_outcome [color="#888888", style=dashed];
}

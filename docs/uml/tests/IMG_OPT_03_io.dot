digraph io {
  rankdir=TB;
  ranksep=0.55;
  nodesep=0.2;
  label="IMG-OPT-03 PSF quality: SIM → ANALYSIS I/O map\ngold = config read, black = FITS written / read (edge labels: header cards), green = outputs";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_cfg {
    label="config/"; style=filled; fillcolor="#fff8dc"; color="#bbbbbb";
    y_config_file_IMG_OPT_03_SIM_yaml [label="config_file_IMG_OPT_03_SIM.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_common_observing_params_yaml [label="config_file_common_observing_params.yaml", shape=note, style=filled, fillcolor="white"];
    y_config_file_IMG_OPT_03_psf_quality_data_states_yaml [label="config_file_IMG_OPT_03_psf_quality_data_states.yaml", shape=note, style=filled, fillcolor="white"];
  }
  subgraph cluster_IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM {
    label="IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM.py";
    style=filled; fillcolor="#d9eed9"; color="#999999";
    IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM__simulate_strehl [label="simulate_strehl\nSimulated data for a Strehl\nrequirement (METIS-1408/-1409,\nMETIS-2864: Strehl >= 0.8)", shape=box, style="rounded,filled", fillcolor="white"];
    IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM__main -> IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM__simulate_strehl [style=dashed];
  }
  fits [shape=record, style=filled, fillcolor="#e8f0fb", label="{data/IMG_OPT_03_psf_quality_simmed_data\n*.fits|<primary> PRIMARY header:\nSTREHREF HALO_SIG HALO_S REQ_ID CASE EXPECTED REQ_PLH SIMVER\nFILTER WCU_FP WCU_PP PSF_KERN ND_FILT BB_TEMP NDIT DIT\nDIT_CFG SAT_ADU PEAKFRAC|{<x_BCKGD_SUBTED> BCKGD_SUBTED|<x_RAW_READOUT> RAW_READOUT|<x_BACKGROUND> BACKGROUND}}"];
  IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM__simulate_strehl -> fits;
  subgraph cluster_IMG_OPT_03_METIS_AIT_img_cal_psf_quality_ANALYSIS {
    label="IMG_OPT_03_METIS_AIT_img_cal_psf_quality_ANALYSIS.py + modules";
    style=filled; fillcolor="#f2f2f2"; color="#999999";
    IMG_OPT_03_METIS_AIT_img_cal_psf_quality_ANALYSIS__main [label="main()", shape=box, style="rounded,filled,bold", fillcolor="white"];
    IMG_OPT_03_METIS_AIT_img_cal_psf_quality_ANALYSIS__log_injected_truth [label="log_injected_truth", shape=box, style="rounded,filled", fillcolor="white"];
  }
  fits:primary -> IMG_OPT_03_METIS_AIT_img_cal_psf_quality_ANALYSIS__log_injected_truth [label="REQ_ID, CASE, REQ_QTY, INJ_VAL, EXPECTED"];
  y_config_file_IMG_OPT_03_SIM_yaml -> IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_03_METIS_AIT_img_cal_psf_quality_SIM__main [color="#b8860b"];
  y_config_file_common_observing_params_yaml -> IMG_OPT_03_METIS_AIT_img_cal_psf_quality_ANALYSIS__main [color="#b8860b"];
  y_config_file_IMG_OPT_03_psf_quality_data_states_yaml -> IMG_OPT_03_METIS_AIT_img_cal_psf_quality_ANALYSIS__main [color="#b8860b"];
  subgraph cluster_out {
    label="outputs"; style=filled; fillcolor="#e6f4e6"; color="#bbbbbb";
    o_logs_IMG_OPT_03_psf_quality_logs [label="logs/IMG_OPT_03_psf_quality_logs/", shape=folder, style=filled, fillcolor="white"];
  }
  IMG_OPT_03_METIS_AIT_img_cal_psf_quality_ANALYSIS__main -> o_logs_IMG_OPT_03_psf_quality_logs [color="#2ca02c"];
}

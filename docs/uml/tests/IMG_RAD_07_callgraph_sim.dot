digraph callgraph {
  rankdir=LR;
  ranksep=0.6;
  nodesep=0.15;
  label="IMG-RAD-07 Photometric performance: SIM call graph (IMG_RAD_07_photometric_performance_SIM.py)\nbox = @pipeline_stage, oval = helper, dashed box = class instantiated, dashed arrow = passed as callback; numbers = call order in main(); hover for the full docstring";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_IMG_RAD_07_photometric_performance_SIM {
    label="IMG_RAD_07_photometric_performance_SIM.py";
    style=filled; fillcolor="#f2f2f2"; color="#999999";
    IMG_RAD_07_photometric_performance_SIM__main [label="main\nGenerate IMG-RAD-07 photometric\nperformance simulations, one set\nper requirement, as set in the\nscenario conf…", tooltip="Generate IMG-RAD-07 photometric performance simulations, one set per requirement,\nas set in the scenario config.", shape=box, style="filled,bold", fillcolor="white"];
    IMG_RAD_07_photometric_performance_SIM__simulate_metis_2594 [label="simulate_metis_2594\nStub for METIS-2594: METIS\ninternal calibration shall provide\na range of flux levels matching\nthat encountere…", tooltip="Stub for METIS-2594: METIS internal calibration shall provide a range of flux\nlevels matching that encountered in scientific operation as defined in METIS-3137.\n\nWrites nothing (the scenario's cases are still checked, so the config stays\nvalid for a future implementation).\n\nOUTPUTS:\n- list[str]: written files (empty)", shape=box, style="filled", fillcolor="white"];
    IMG_RAD_07_photometric_performance_SIM__simulate_metis_2883 [label="simulate_metis_2883\nSimulated data for METIS-2883: the\nsource used for detector linearity\ncalibration shall provide an\nilluminati…", tooltip="Simulated data for METIS-2883: the source used for detector linearity calibration\nshall provide an illumination that is spatially homogeneous within +/- 3%\npeak-to-valley over the science field of view.\n\nPer case, a full-aperture ScopeSim flat with a smooth illumination pattern injected\nso that max |pixel / mean - 1| = injected half_ptv (on top of whatever\ninhomogeneity ScopeSim itself produces). Writes one PASS case and one FAIL case\n(and e.g. one near the limit, if configured).\n\nOUTPUTS:\n- list[str]: written files", shape=box, style="filled", fillcolor="white"];
    IMG_RAD_07_photometric_performance_SIM__simulate_metis_3300 [label="simulate_metis_3300\nSimulated data for METIS-3300: the\nlevel of flux of the flat field\nshall be tunable to 15 discrete\nvalues and…", tooltip="Simulated data for METIS-3300: the level of flux of the flat field shall be tunable\nto 15 discrete values and shall be known at each step to 0.3%; the resulting\nspatial illumination pattern shall remain constant across the field within 0.5%\nafter tuning.\n\nFlux steps: the WCU black-body aperture is fixed (bb_aperture); the exposure\nE = T_ND x DIT is stepped linearly, E_k = E_max * k / n_steps (header NOMFLUX = k /\nn_steps, the nominal relative flux). E_max puts the raw peak (background included,\nwhich scales with E too) at sim_common.MAX_RAW_FRAC of saturation / (1 +\npeak_margin), scaled from the probe ctx.lit_frame() (base ND and DIT). Per step,\nthe least attenuating ND of nd_filters with DIT = E_k / T_ND >= the detector's\nminimum DIT is used (choose_nd_and_dit), with two darks and a flat read out at that\nND and DIT (the background scales with it). Per case and step, injected:\n- flux error: the flux is off the nominal by +/- flux_error (alternating sign),\n- pattern change: a smooth pattern with amplitude ramping from -pattern_change to\n  +pattern_change over the steps (so each step's normalised flat differs from the\n  step-averaged one by at most pattern_change).\nWrites ..._<case>_stepNN.fits for one PASS case and one FAIL case (more if\nconfigured), one ScopeSim readout per step shared by all cases.\n\nOUTPUTS:\n- list[str]: written files", shape=box, style="filled", fillcolor="white"];
    IMG_RAD_07_photometric_performance_SIM__simulate_metis_3291 [label="simulate_metis_3291\nSimulated data for METIS-3291:\nMETIS shall allow the\ncharacterisation and correction of\nthe relative spectral…", tooltip="Simulated data for METIS-3291: METIS shall allow the characterisation and\ncorrection of the relative spectral response function (RSRF) with 3% precision\nover the wavelength range specified in METIS-1090.\n\nNeeds an LSS instrument set-up (wcu_lss_l/m/n). From the un-injected ScopeSim\nsignal (lit frame - dark_1), with the naming of modules/rsrf_common.py:\n- wavelength per pixel from ScopeSim's spectral trace, and S_empirical, the sum\n  over the illuminated slit columns per row,\n- S_perfect: the BB at the WCU temperature (unit throughput and QE), scaled so its\n  integral is src_scale_factor x that of S_empirical,\n- alpha_fcn: the observing filter's smoothed ripple, scaled so that\n  integral(S_perfect * alpha_fcn) = alpha_integral_frac x integral(S_perfect),\n- the reference RSRF, RSRF_REF = S_empirical / (S_perfect * alpha_fcn).\nThe RSRF is evaluated on the rows inside the trace's range and the filter passband\n(standing in for the METIS-1090 range). Per case, the signal is multiplied by\n(1 + rsrf_error * P(lambda)), P a smooth pattern in wavelength with mean 0 and max\n|P| = 1 over the evaluated rows (rsrf_error_pattern), so the RSRF measured from\nthe case file deviates from RSRF_REF by max |rsrf / RSRF_REF - 1| = rsrf_error\n(plus noise; rsrf_deviation). Each case file gets an 'RSRF' table extension\n(rsrf_table) with the wavelength solution, the model and the reference and true\nRSRFs, for the ANALYSIS. Writes one PASS case and one FAIL case (more if\nconfigured).\n\nOUTPUTS:\n- list[str]: written files", shape=box, style="filled", fillcolor="white"];
    IMG_RAD_07_photometric_performance_SIM__max_exposure [label="max_exposure\nLargest exposure E = T_ND x DIT\n(s) for which the raw peak\n(background included, which also\nscales with T_ND…", tooltip="Largest exposure E = T_ND x DIT (s) for which the raw peak (background included,\nwhich also scales with T_ND x DIT) stays at max_raw / (1 + margin), from a probe\nreadout peaking at peak_raw with ND transmission t_probe and DIT dit_probe.\n\nRaises ValueError if the probe has no positive peak.", shape=ellipse];
    IMG_RAD_07_photometric_performance_SIM__choose_nd_and_dit [label="choose_nd_and_dit\nND filter and DIT giving an\nexposure T_ND x DIT: the least\nattenuating ND (highest\ntransmission) for which DI…", tooltip="ND filter and DIT giving an exposure T_ND x DIT: the least attenuating ND (highest\ntransmission) for which DIT = exposure / T_ND is >= mindit, so the DIT stays legal.\n\nINPUTS:\n- exposure (float): T_ND x DIT (s)\n- nd_transmissions (dict): ND name -> transmission\n- mindit (float): minimum DIT (s)\n\nOUTPUTS:\n- str: ND name\n- float: DIT (s)\n\nRaises ValueError if even the most attenuating ND needs DIT < mindit.", shape=ellipse];
    IMG_RAD_07_photometric_performance_SIM__exposure_steps [label="exposure_steps\nLinearly spaced exposures e_max *\nk / n_steps, k = 1..n_steps", tooltip="Linearly spaced exposures e_max * k / n_steps, k = 1..n_steps.", shape=ellipse];
    IMG_RAD_07_photometric_performance_SIM__rsrf_error_pattern [label="rsrf_error_pattern\nSmooth pattern P(lambda) for the\nMETIS-3291 injection: a tilt, a\ncurvature and a slow wave in x =\nlambda scal…", tooltip="Smooth pattern P(lambda) for the METIS-3291 injection: a tilt, a curvature and a\nslow wave in x = lambda scaled to [-1, 1] over lam_eval_um (the rows the RSRF is\nevaluated on; x is clipped outside them), with mean 0 and max |P| = 1 over\nlam_eval_um, so that an RSRF times (1 + a * P) deviates from the original by at\nmost a there.\n\nINPUTS:\n- lam_um (ndarray): wavelengths to evaluate P at [um] (any shape)\n- lam_eval_um (ndarray): wavelengths of the evaluated rows [um]\n\nOUTPUTS:\n- ndarray: P, the shape of lam_um", shape=ellipse];
    IMG_RAD_07_photometric_performance_SIM__rsrf_deviation [label="rsrf_deviation\nThe quantity METIS-3291 is tested\non: max |rsrf / rsrf_ref - 1| over\nthe evaluated rows (what the SIM\ninjects…", tooltip="The quantity METIS-3291 is tested on: max |rsrf / rsrf_ref - 1| over the evaluated\nrows (what the SIM injects as rsrf_error).", shape=ellipse];
    IMG_RAD_07_photometric_performance_SIM__rsrf_table [label="rsrf_table\nRSRF extension (one row per\ndetector row): the wavelength\nsolution, the un-injected\nS_empirical, the model (S…", tooltip="RSRF extension (one row per detector row): the wavelength solution, the\nun-injected S_empirical, the model (S_perfect, alpha_fcn), the reference RSRF and\nthe injected (true) RSRF of the case.\n\nINPUTS:\n- spec (rsrf_common.SlitSpectrum): of the un-injected signal\n- evaluate (ndarray): bool per row, RSRF evaluated there\n- model (dict): s_perfect, alpha, rsrf_ref (per row)\n- pattern_rows (ndarray): rsrf_error_pattern per row\n- rsrf_error (float): injected amplitude\n\nOUTPUTS:\n- fits.BinTableHDU: EXTNAME 'RSRF'", shape=ellipse];
    IMG_RAD_07_photometric_performance_SIM__fyi_plot_rsrf [label="fyi_plot_rsrf\nFYI plot of the METIS-3291\nsimulation: left, S_empirical (un-\ninjected), S_perfect and S_perfect\n* alpha_fcn;…", tooltip="FYI plot of the METIS-3291 simulation: left, S_empirical (un-injected), S_perfect\nand S_perfect * alpha_fcn; right, the reference RSRF (RSRF_REF).\n\nINPUTS:\n- plot_dir (str): where to write fyi_sim_<label>.png\n- label (str): e.g. 'METIS-3291_L_spec'\n- spec (rsrf_common.SlitSpectrum), model (dict): see rsrf_table\n\nOUTPUTS:\n- str: path of the written plot", shape=ellipse];
  }
  subgraph cluster_paths {
    label="modules/paths.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    paths__project_root [label="project_root\nThe project root\n(METIS_MAIT_code_eckhart/), as set\nin config/paths.yaml", tooltip="The project root (METIS_MAIT_code_eckhart/), as set in config/paths.yaml.\n\nOUTPUTS\n-------\nstr\n    Absolute path, ending in '/' (scripts append to it, e.g. stem + \"data/\").", shape=ellipse];
    paths___load_paths [label="_load_paths\nLoad (once) the paths config from\nPATHS_FILE.", tooltip="Load (once) the paths config from PATHS_FILE.", shape=ellipse];
  }
  subgraph cluster_sim_common {
    label="modules/sim_common.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    sim_common__sim_plot_dir [label="sim_plot_dir\nDirectory for a SIM script's FYI\nplots: <stem>sim_plots/<script\nname>/.", tooltip="Directory for a SIM script's FYI plots: <stem>sim_plots/<script name>/.\n\nINPUTS:\n- stem (str): project root (project_root())\n- sim_script (str): path of the SIM script (its __file__)\n\nOUTPUTS:\n- str: the directory, ending in '/'", shape=ellipse];
    sim_common__start_sim_logging [label="start_sim_logging\nLog file <stem>logs/<log_subdir>/l\nog_<log_stub>_<timestamp>.txt", tooltip="Log file <stem>logs/<log_subdir>/log_<log_stub>_<timestamp>.txt.", shape=ellipse];
    sim_common__setup_scopesim [label="setup_scopesim\nPoint ScopeSim at the local IRDB\nand log the versions of things", tooltip="Point ScopeSim at the local IRDB and log the versions of things.", shape=ellipse];
    sim_common__run_scenario [label="run_scenario\nRun the requirement simulators of\na scenario config: for each\ninstrument, one OpticalTrain, with\nthe DIT shor…", tooltip="Run the requirement simulators of a scenario config: for each instrument, one\nOpticalTrain, with the DIT shortened if needed so the raw readout (aperture fully\nopen) peaks at <= MAX_RAW_FRAC of saturation (limit_dit_to_saturation); for each\nrequirement with simulate: true that applies to it, the requirement's simulator,\nsimulator(ctx, req_key, req_cfg) -> list of written files, with req_cfg resolved\nfor the instrument's detector (see resolve_for_detector).\n\nINPUTS:\n- scenario (dict): the scenario config\n- simulators (dict): requirement key -> simulator function\n- observing (dict): merged observing config (common + test-specific)\n- out_dir (str): directory to write to\n- test_prefix (str): file name prefix, e.g. 'IMG_OPT_04'\n- plot_dir (str or None): directory for FYI plots (ctx.plot_dir), if any; see\n  sim_plot_dir\n\nOUTPUTS:\n- dict: (requirement key, instrument name) -> list of written files", shape=ellipse];
    sim_common__sim_version [label="sim_version\nShort string of the ScopeSim, IRDB\nMETIS and code versions (for\nSIMVER)", tooltip="Short string of the ScopeSim, IRDB METIS and code versions (for SIMVER).", shape=ellipse];
    sim_common__scenario_instruments [label="scenario_instruments\nname -> instrument config, from\n'instruments:' or a single\n'instrument:'.", tooltip="name -> instrument config, from 'instruments:' or a single 'instrument:'.", shape=ellipse];
    sim_common__requirement_applies [label="requirement_applies\nTrue if a requirement is to be\nsimulated for this instrument", tooltip="True if a requirement is to be simulated for this instrument.", shape=ellipse];
    sim_common__build_optical_train [label="build_optical_train\nScopeSim OpticalTrain for one WCU\nset-up (pupil mask and matching\nPSF kernel set, IPC on or off)", tooltip="ScopeSim OpticalTrain for one WCU set-up (pupil mask and matching PSF kernel set,\nIPC on or off).", shape=ellipse];
    sim_common__saturation_of [label="saturation_of\nSaturation level (ADU per DIT)\nfrom the observing config, or\nNone: that of obs_mode in\nsaturation_adu_by_obs_…", tooltip="Saturation level (ADU per DIT) from the observing config, or None: that of\nobs_mode in saturation_adu_by_obs_mode (modes whose detector readout mode differs\nfrom the imaging default, e.g. the LSS modes), else that of the detector in\nsaturation_adu.", shape=ellipse];
    sim_common__detector_key [label="detector_key\nDetector key ('img_lm' or 'img_n')\nof a WCU imaging obs_mode", tooltip="Detector key ('img_lm' or 'img_n') of a WCU imaging obs_mode.", shape=ellipse];
    sim_common__limit_dit_to_saturation [label="limit_dit_to_saturation\nShorten the DIT, if needed, so\nthat the peak of the raw readout\n(aperture fully open) is <=\nmax_frac * satura…", tooltip="Shorten the DIT, if needed, so that the peak of the raw readout (aperture fully\nopen) is <= max_frac * saturation_adu. Never lengthens it.\n\nEach trial takes a dark and an illuminated readout at the current DIT. If the raw\npeak is too high, the DIT is rescaled to aim at target_frac * saturation, assuming\nthe signal is linear in DIT on top of the dark level:\n    dit_new = dit * (target_frac * sat - median(dark)) / (peak - median(dark)),\nat most halving the DIT per trial if the peak is at saturation (the readout may be\nclipped there, which makes the linear estimate too optimistic). The readouts are\nper DIT (ScopeSim averages over NDIT), so NDIT is left as it is; the trials use\ntrial_ndit (default 1: quick, and the noisier peak errs on the safe side; None for\nthe configured NDIT).\n\nINPUTS:\n- metis: OpticalTrain\n- instrument (dict): instrument config, with 'dit' and 'ndit' (not modified)\n- saturation_adu (float): saturation level (ADU per DIT)\n- max_frac, target_frac (float): limit and aim for the raw peak, as fractions of\n  saturation\n- max_iter (int): maximum number of trials\n- readout_fn: readout function, readout_fn(metis, bb_aperture, instrument) ->\n  (frame, header); injectable for tests\n- trial_ndit (int or None): NDIT of the trial readouts\n\nOUTPUTS:\n- dict: a copy of instrument with 'dit' set to the tuned DIT\n- dict: dit_cfg, dit, peak_frac (raw peak / saturation of the last trial), n_trials\n\nRaises ValueError if the dark level alone is >= target_frac * saturation, and\nRuntimeError if no DIT within max_iter trials is short enough.", shape=ellipse];
    sim_common__resolve_for_detector [label="resolve_for_detector\nRequirement config for one\ndetector: a copy of req_cfg with\nthe keys in\nreq_cfg['by_detector'][det_key]\n(if a…", tooltip="Requirement config for one detector: a copy of req_cfg with the keys in\nreq_cfg['by_detector'][det_key] (if any) overriding the top-level ones.", shape=ellipse];
    sim_common__check_cases [label="check_cases\nCheck the cases of a requirement:\na 'pass' and a 'fail' case exist,\nevery case injects every limited\nquantity…", tooltip="Check the cases of a requirement: a 'pass' and a 'fail' case exist, every case\ninjects every limited quantity, and the 'pass'/'fail' cases are on the right side\nof the limit. Exits otherwise.\n\nOUTPUTS:\n- dict: case name -> EXPECTED ('PASS' or 'FAIL')", shape=ellipse];
    sim_common__instrument_tag [label="instrument_tag\nInstrument label in file filters:\nits scenario filter, else the\nfilter", tooltip="Instrument label in file filters: its scenario filter, else the filter.", shape=ellipse];
    sim_common__SimContext_darks [label="SimContext.darks\n(dark_1, dark_2): see take_darks", tooltip="(dark_1, dark_2): see take_darks.", shape=ellipse];
    sim_common__SimContext_lit_frame [label="SimContext.lit_frame\n(frame, header): readout with the\nWCU black-body aperture fully open", tooltip="(frame, header): readout with the WCU black-body aperture fully open.", shape=ellipse];
    sim_common__smooth_pattern [label="smooth_pattern\nSmooth illumination pattern over\nthe frame with mean 0 and max |P|\n= 1, so that flat * (1 + a * P)\ndeviates f…", tooltip="Smooth illumination pattern over the frame with mean 0 and max |P| = 1, so that\nflat * (1 + a * P) deviates from its mean by at most a.", shape=ellipse];
    sim_common__SimContext_write_case [label="SimContext.write_case\nwrite_case_file with dark_2 as\nBACKGROUND, the lit frame's header\nand the saturation check, into\nout_dir (or…", tooltip="write_case_file with dark_2 as BACKGROUND, the lit frame's header and the\nsaturation check, into out_dir (or its subdirectory subdir, if given).", shape=ellipse];
    sim_common__requirement_cards [label="requirement_cards\nFITS header cards with the\nrequirement and the injected truth", tooltip="FITS header cards with the requirement and the injected truth.", shape=ellipse];
    sim_common__detector_mindit [label="detector_mindit\nMinimum DIT (s) of the detector\nreadout mode (!DET.mindit)", tooltip="Minimum DIT (s) of the detector readout mode (!DET.mindit).", shape=ellipse];
    sim_common__nd_transmission [label="nd_transmission\nTransmission of ND filter `filter`\nof the ND wheel: the plateau of\nits (grey) curve", tooltip="Transmission of ND filter `filter` of the ND wheel: the plateau of its (grey) curve.\n\nRaises ValueError if the curve is not grey (nonzero values differing by > 1%).", shape=ellipse];
    sim_common__readout_frame [label="readout_frame\nObserve with the WCU black-body\naperture at bb_aperture; read out\none frame", tooltip="Observe with the WCU black-body aperture at bb_aperture; read out one frame.", shape=ellipse];
    sim_common__set_nd_filter [label="set_nd_filter\nPut ND filter `filter` (one of the\nND wheel's, e.g", tooltip="Put ND filter `filter` (one of the ND wheel's, e.g. 'ND_OD3') in the beam.", shape=ellipse];
    sim_common__take_darks [label="take_darks\nTwo independent darks (black-body\naperture closed): dark_1 to\nextract the signal from the\nilluminated frames,…", tooltip="Two independent darks (black-body aperture closed): dark_1 to extract the signal\nfrom the illuminated frames, dark_2 to write out as BACKGROUND.", shape=ellipse];
    sim_common__write_case_file [label="write_case_file\nWrite one case: primary header\n(ScopeSim's + set-up + requirement\ncards), then BCKGD_SUBTED (raw -\nbackground…", tooltip="Write one case: primary header (ScopeSim's + set-up + requirement cards), then\nBCKGD_SUBTED (raw - background), RAW_READOUT and BACKGROUND, as float32, then\nextra_hdus (astropy HDUs, written as given). If saturation_adu is given, the header\nalso gets SAT_ADU and PEAKFRAC (max of the raw readout / saturation), and a warning\nis logged if PEAKFRAC > MAX_RAW_FRAC.\n\nOUTPUTS:\n- str: path of the written file", shape=ellipse];
    sim_common__SimContext [label="SimContext(...)", tooltip="What a requirement simulator needs for one instrument set-up: the OpticalTrain,\nthe instrument config (DIT already tuned), the merged observing config, the\ndetector saturation level, where and how to write (incl. an optional directory for\nFYI plots), and (cached, so requirements simulated for the same instrument share\nthem) two independent darks and a full-aperture illuminated frame.", shape=box, style="rounded,dashed,filled", fillcolor="white"];
  }
  subgraph cluster_config_common {
    label="modules/config_common.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    config_common__load_observing_config [label="load_observing_config\nLoad the common observing config,\nthen merge each test-specific\nconfig on top, in order (top-level\nkeys of la…", tooltip="Load the common observing config, then merge each test-specific config on top, in\norder (top-level keys of later files override earlier ones).\n\nINPUTS\n----------\nstem : str\n    Project root (METIS_MAIT_code_eckhart/), prepended to relative paths.\n*test_config_files : str\n    Test-specific observing configs, relative to stem or absolute.\n\nOUTPUTS\n-------\ndict\n    The merged observing config.", shape=ellipse];
  }
  subgraph cluster_helpers {
    label="modules/helpers.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    helpers__load_config_and_pipe [label="load_config_and_pipe\nLoad a YAML configuration file and\npipe its contents to the log", tooltip="Load a YAML configuration file and pipe its contents to the log.\n\nINPUTS\n----------\nconfig_file_choice : str\n    Path to the configuration file.\nprint_one_line : bool, optional\n    If True, log the entire config on a single line. If False (default), log\n    in a more readable, multiline format.\n\nOUTPUTS\n-------\nconfig_this : dict\n    The configuration dictionary loaded from file.", shape=ellipse];
  }
  subgraph cluster_rsrf_common {
    label="modules/rsrf_common.py";
    style=filled; fillcolor="#ece4f3"; color="#999999";
    rsrf_common__lss_wavelength_map [label="lss_wavelength_map\nWavelength and slit position of\nevery detector pixel, from the\nfirst spectral trace of the\nOpticalTrain", tooltip="Wavelength and slit position of every detector pixel, from the first spectral\ntrace of the OpticalTrain.\n\nINPUTS:\n- metis (OpticalTrain): in an LSS mode (with a 'spectral_traces' effect)\n- shape (tuple): (ny, nx) of the detector frame\n- det_key (str): 'img_lm' or 'img_n' (selects the detector layout file)\n- irdb_dir (str): IRDB location\n\nOUTPUTS:\n- ndarray: wavelength per pixel [um]\n- ndarray: slit position xi per pixel [arcsec]\n- trace: the ScopeSim spectral trace used (wave_min, wave_max, trace_id)", shape=ellipse];
    rsrf_common__slit_spectrum [label="slit_spectrum\nSlit-collapsed spectrum: the sum\nover the illuminated columns\n(slit_columns), with each row's\nmedian slit wav…", tooltip="Slit-collapsed spectrum: the sum over the illuminated columns (slit_columns), with\neach row's median slit wavelength; rows are flagged in_range if inside\n[wave_min, wave_max] (no extrapolation of the trace).\n\nOUTPUTS:\n- SlitSpectrum", shape=ellipse];
    rsrf_common__filter_file_of [label="filter_file_of\nFilter curve file of obs_filter (p\nolychromatic_observing_filters_<ba\nnd>_...)", tooltip="Filter curve file of obs_filter (polychromatic_observing_filters_<band>_...).", shape=ellipse];
    rsrf_common__filter_ripple [label="filter_ripple\nRipple of a filter curve: (curve,\nlightly smoothed) / (its broad in-\nband trend), taken in the passband\n(T > i…", tooltip="Ripple of a filter curve: (curve, lightly smoothed) / (its broad in-band trend),\ntaken in the passband (T > in_band_frac x max(T)) and 1 outside it. The trend is\na normalized convolution of the in-band samples only, so the band edges don't pull\nit down; in_band_frac ~0.9 keeps the steep edges out of the ripple.\n\nINPUTS:\n- filter_file (Path): table with columns wavelength [um], transmission\n- ripple_sigma_um (float): light smoothing (keeps the ripple, removes noise)\n- trend_sigma_um (float): broad smoothing (the trend divided out)\n- in_band_frac (float): passband threshold, as a fraction of max(T)\n\nOUTPUTS:\n- ndarray: filter wavelengths [um]\n- ndarray: ripple (~1 in band, 1 outside)\n- ndarray: bool, in the passband", shape=ellipse];
    rsrf_common__eval_rows [label="eval_rows\nRows on which the RSRF is\nevaluated: inside the trace's\nwavelength range and in the filter\npassband (stands i…", tooltip="Rows on which the RSRF is evaluated: inside the trace's wavelength range and in\nthe filter passband (stands in for the METIS-1090 wavelength range).", shape=ellipse];
    rsrf_common__perfect_bb_spectrum [label="perfect_bb_spectrum\nBlack-body spectrum through a\nsystem of unit throughput and QE,\nin ADU per row: B_ph(lam, T) *\narea * pixel s…", tooltip="Black-body spectrum through a system of unit throughput and QE, in ADU per row:\n  B_ph(lam, T) * area * pixel solid angle * n_cols * dlam per row * exptime / gain\n(1 photon = 1 e-). Not included: BB emissivity, BB -> integrating-sphere coupling\nand gain, BB aperture, the sphere's own thermal emission.\n\nINPUTS:\n- lam_rows_um (ndarray): wavelength per row [um] (all rows, so the row widths\n  np.gradient(lam_rows_um) are defined everywhere)\n- bb_temp (Quantity or float): BB temperature [K]\n- area, pixel_scale: Quantities (or floats in m2, arcsec), e.g. from\n  metis.cmds['!TEL.area'], metis.cmds['!INST.pixel_scale']\n- gain (float): e- / ADU\n- n_cols (int): number of slit columns summed\n- exptime_s (float): DIT x NDIT [s]\n\nOUTPUTS:\n- ndarray: ADU per row", shape=ellipse];
    rsrf_common__scale_to_integral [label="scale_to_integral\nS_perfect: s_unit scaled so that\nsum(S_perfect) = factor x\nsum(s_empirical) (sums over the\nrows given)", tooltip="S_perfect: s_unit scaled so that sum(S_perfect) = factor x sum(s_empirical) (sums\nover the rows given).\n\nOUTPUTS:\n- ndarray: S_perfect\n- float: the scale applied", shape=ellipse];
    rsrf_common__make_alpha_fcn [label="make_alpha_fcn\nalpha_fcn(lambda) = alpha_scale x\nripple(lambda), with alpha_scale\nsuch that sum(S_perfect *\nalpha_fcn) = int…", tooltip="alpha_fcn(lambda) = alpha_scale x ripple(lambda), with alpha_scale such that\nsum(S_perfect * alpha_fcn) = integral_frac x sum(S_perfect) over the rows lam_um.\n\nOUTPUTS:\n- callable: alpha_fcn(lam_um)\n- float: alpha_scale", shape=ellipse];
    rsrf_common__rsrf [label="rsrf\nrsrf = S_empirical / (S_perfect *\nalpha_fcn)", tooltip="rsrf = S_empirical / (S_perfect * alpha_fcn).", shape=ellipse];
    rsrf_common__SlitSpectrum [label="SlitSpectrum(...)", tooltip="Slit-collapsed spectrum of a frame (one entry per detector row).", shape=box, style="rounded,dashed,filled", fillcolor="white"];
  }

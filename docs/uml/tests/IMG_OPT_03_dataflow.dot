digraph dataflow {
  rankdir=LR;
  ranksep=0.9;
  nodesep=0.12;
  label="IMG-OPT-03 PSF quality: data flow of the result fields (ANALYSIS)\nsolid blue = stage writes the field, dashed grey = stage reads it; italic = property (derived)";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  node [shape=box, style="rounded,filled", fillcolor="white", penwidth=1.5];
  ctor_PsfGrid_backbone_img_03_psf_quality_prepare_psf_grid [label="PsfGrid(...)\n(in prepare_psf_grid)"];
  ctor_SinglePsfFitResult_backbone_img_03_psf_quality_process_one_psf [label="SinglePsfFitResult(...)\n(in process_one_psf)"];
  ctor_StrehlRunResult_backbone_img_03_psf_quality_collect_strehls [label="StrehlRunResult(...)\n(in collect_strehls)"];
  IMG_OPT_03_METIS_AIT_img_cal_psf_quality_ANALYSIS_main [label="main", tooltip="Run the IMG-OPT-03 Strehl analysis for each data state."];
  backbone_img_03_psf_quality_prepare_psf_grid [label="prepare_psf_grid", tooltip="Load a FITS file with a grid of PSFs, resolve the mask-dependent observing config,\nand find the 1st-pass centroids of the PSFs.\n\nINPUTS\n----------\nfile_name_abs : str\n    Path to the FITS file containing the PSF grid to analyze.\nfp_mask : str\n    Focal-plane mask label (sets the LM/N band).\npp_mask : str\n    Pupil-plane mask label (sets the reference aperture geometry).\nfilter_name : str, optional\n    Name of the observing filter associated with the PSF grid.\npsfs_subset : str or int, optional\n    Either ``\"all\"`` to process the full grid or an integer giving how many PSFs\n    from the start of the centroid list to process.\nconfig_coords_guesses_file_name_abs : str, optional\n    Path to the configuration file containing initial coordinate guesses.\nconfig_observing : dict, optional\n    Observing configuration dictionary.\noversample_factor : int, optional\n    Oversampling factor for centroiding and fitting (keep odd to facilitate\n    centering).\n\nOUTPUTS\n-------\nPsfGrid\n    The frame, the resolved observing config, the 1st-pass centroids and PSF\n    counts; input to cutout_psf / process_one_psf, collect_strehls and\n    plot_strehl_fov."];
  backbone_img_03_psf_quality_cutout_psf [label="cutout_psf", tooltip="Native-sampling square cutout of PSF num_coord, around the closest ints to its\n1st-pass centroid (input to process_one_psf).\n\nINPUTS\n----------\npsf_grid : PsfGrid\n    From prepare_psf_grid.\nnum_coord : int\n    Zero-based index of the PSF.\n\nOUTPUTS\n-------\nnp.ndarray\n    Cutout of side psf_grid.edge_size_original (native pixels)."];
  backbone_img_03_psf_quality_collect_strehls [label="collect_strehls", tooltip="Gather the per-PSF fit results (in the order of the 1st-pass centroids) into one\nresult for the file.\n\nINPUTS\n----------\npsf_grid : PsfGrid\n    From prepare_psf_grid.\nfit_results : list[SinglePsfFitResult]\n    From process_one_psf, one per PSF processed (index = num_coord).\n\nOUTPUTS\n-------\nStrehlRunResult\n    Per-PSF Strehl estimates (+ 1st-pass centroids) and PSF counts; verdicts still\n    empty (see the requirement checks and log_test_outcome)."];
  backbone_img_03_psf_quality_plot_strehl_fov [label="plot_strehl_fov", tooltip="FYI plots on the detector frame: the Strehl of each PSF, and the Strehl from all\nmethods for one randomly chosen PSF.\n\nINPUTS\n----------\nrun_result : StrehlRunResult\n    From collect_strehls.\ngrid_data : np.ndarray\n    The detector frame (native pixel scale), e.g. PsfGrid.grid_data.\nresults_write_dir : str\n    Directory where the plots are saved.\n\nOUTPUTS\n-------\nNone\n    Saves the plots."];
  backbone_img_03_psf_quality_metis_1408_1409_check [label="metis_1408_1409_check", tooltip="Decide METIS-1408 (Strehl >= 80% at lambda > 3 um in all modes over the entire FOV)\nand METIS-1409 (Strehl > 0.8 at 3 um for IMG-LM and -NQ over the full FOV): every\nPSF has Strehl (criterion_key) >= strehl_min (see _strehl_verdict for FAIL /\nINCONCLUSIVE / NOT EVALUATED).\n\nINPUTS:\n- run_result (StrehlRunResult): from collect_strehls\n- criterion_key (str): Strehl estimator used for pass/fail\n- strehl_min (float): minimum Strehl ratio\n\nOUTPUTS:\n- run_result (StrehlRunResult), with verdicts['METIS-1408'] and\n  verdicts['METIS-1409'] set"];
  backbone_img_03_psf_quality_metis_2864_check [label="metis_2864_check", tooltip="Decide METIS-2864 (minimum Strehl of the WCU+CFO+IMG-LM optical path > 80% at\n3.3 um over the entire FOV): the same Strehl criterion as metis_1408_1409_check,\nfor LM data only; N/A for N-band data.\n\nINPUTS:\n- run_result (StrehlRunResult): from collect_strehls\n- criterion_key (str): Strehl estimator used for pass/fail\n- strehl_min (float): minimum Strehl ratio\n\nOUTPUTS:\n- run_result (StrehlRunResult), with verdicts['METIS-2864'] set"];
  backbone_img_03_psf_quality_metis_3503_check [label="metis_3503_check", tooltip="Decide METIS-3503 (the shape of the instrument PSF can be characterised across the\nentire FoV using the WCU): PASS if every PSF in the grid was analysed and has a\nfinite Strehl estimate (criterion_key); FAIL if any analysed PSF has a non-finite\none; INCONCLUSIVE if only a subset of the grid was analysed; NOT EVALUATED if\ncriterion_key is missing for some PSF.\n\nINPUTS:\n- run_result (StrehlRunResult): from collect_strehls\n- criterion_key (str): Strehl estimator whose fit must have succeeded\n\nOUTPUTS:\n- run_result (StrehlRunResult), with verdicts['METIS-3503'] set"];
  backbone_img_03_psf_quality_log_test_outcome [label="log_test_outcome", tooltip="Log the outcome of each IMG-OPT-03 requirement (as decided by\nmetis_1408_1409_check, metis_2864_check and metis_3503_check) and of the whole\ntest: PASS if all applicable requirements pass; FAIL if any fails; else\nINCONCLUSIVE.\n\nINPUTS:\n- run_result (StrehlRunResult): with verdicts set by the requirement checks\n\nOUTPUTS:\n- run_result (StrehlRunResult), with verdict_overall set"];
  subgraph cluster_PsfGrid {
    label="PsfGrid (backbone_img_03_psf_quality)";
    style=filled; fillcolor="#d9eed9"; color="#999999";
    f_file_name_abs [label="file_name_abs", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_filter_name [label="filter_name", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_fp_mask [label="fp_mask", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_pp_mask [label="pp_mask", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_config_observing [label="config_observing", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_grid_data [label="grid_data", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_grid_data_original [label="grid_data_original", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_coords_centroided_1st_pass_all_native [label="coords_centroided_1st_pass_all_native", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_num_psfs_to_process [label="num_psfs_to_process", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_total_psfs [label="total_psfs", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_oversample_factor [label="oversample_factor", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_edge_size_original [label="edge_size_original", shape=note, style=filled, fillcolor="white", penwidth=1];
  }
  subgraph cluster_SinglePsfFitResult {
    label="SinglePsfFitResult (backbone_img_03_psf_quality)";
    style=filled; fillcolor="#d9eed9"; color="#999999";
    f_coord_x_normsamp [label="coord_x_normsamp", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_coord_y_normsamp [label="coord_y_normsamp", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_fwhm_x_normsamp [label="fwhm_x_normsamp", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_fwhm_y_normsamp [label="fwhm_y_normsamp", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_amplitude_counts [label="amplitude_counts", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_gaussian_based_strehl [label="gaussian_based_strehl", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_strehl_updates [label="strehl_updates", shape=note, style=filled, fillcolor="white", penwidth=1];
  }
  subgraph cluster_StrehlRunResult {
    label="StrehlRunResult (backbone_img_03_psf_quality)";
    style=filled; fillcolor="#d9eed9"; color="#999999";
    f_band [label="band", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_strehl_results_all [label="strehl_results_all", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_num_psfs_processed [label="num_psfs_processed", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_verdicts [label="verdicts", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_verdict_overall [label="verdict_overall", shape=note, style=filled, fillcolor="white", penwidth=1];
  }
  ctor_PsfGrid_backbone_img_03_psf_quality_prepare_psf_grid -> f_file_name_abs [color="#1f77b4"];
  ctor_PsfGrid_backbone_img_03_psf_quality_prepare_psf_grid -> f_filter_name [color="#1f77b4"];
  ctor_PsfGrid_backbone_img_03_psf_quality_prepare_psf_grid -> f_fp_mask [color="#1f77b4"];

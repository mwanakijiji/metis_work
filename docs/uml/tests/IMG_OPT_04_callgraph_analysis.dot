    helpers__setup_logging [label="setup_logging\nInitialize logging with a file +\nconsole handler and pipe basic\nmetadata", tooltip="Initialize logging with a file + console handler and pipe basic metadata.\n\nINPUTS\n----------\nlog_dir : str\n    Directory where the log file should be written.\nlog_file_name : str\n    Full path to the output log file.\nnow : datetime.datetime, optional\n    Timestamp used for the \"created at\" log line. If None, that line is skipped.\n\nOUTPUTS\n-------\nNone\n    Configures the root logger and writes startup log lines.", shape=ellipse];
    helpers__load_config_and_pipe [label="load_config_and_pipe\nLoad a YAML configuration file and\npipe its contents to the log", tooltip="Load a YAML configuration file and pipe its contents to the log.\n\nINPUTS\n----------\nconfig_file_choice : str\n    Path to the configuration file.\nprint_one_line : bool, optional\n    If True, log the entire config on a single line. If False (default), log\n    in a more readable, multiline format.\n\nOUTPUTS\n-------\nconfig_this : dict\n    The configuration dictionary loaded from file.", shape=ellipse];
  }
  subgraph cluster_config_common {
    label="modules/config_common.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    config_common__load_observing_config [label="load_observing_config\nLoad the common observing config,\nthen merge each test-specific\nconfig on top, in order (top-level\nkeys of la…", tooltip="Load the common observing config, then merge each test-specific config on top, in\norder (top-level keys of later files override earlier ones).\n\nINPUTS\n----------\nstem : str\n    Project root (METIS_MAIT_code_eckhart/), prepended to relative paths.\n*test_config_files : str\n    Test-specific observing configs, relative to stem or absolute.\n\nOUTPUTS\n-------\ndict\n    The merged observing config.", shape=ellipse];
  }
  subgraph cluster_psf_grid_prep {
    label="modules/psf_grid_prep.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    psf_grid_prep__load_fits_data [label="load_fits_data\nLoad image data and header\nmetadata from a selected FITS HDU.", tooltip="Load image data and header metadata from a selected FITS HDU.\n\nUses ``memmap=False``. If the path is on a flaky Podman/macOS share and open\nraises errno 35 (Resource deadlock avoided), copies the file to ``/tmp`` (with\n``cp``, ``dd`` or ``cat``) and opens that instead.\n\nIf ``hdu_index`` is past the end of the file, not an EXTNAME in the file, or that\nHDU has no array data, falls back to the first HDU that contains a usable image\narray (usually the primary HDU at index 0 for single-extension FITS files).\n\nINPUTS\n----------\nfile_name : str\n    Abs path to the FITS file containing the PSF-grid data.\nhdu_index : int or str, optional\n    Preferred HDU: an index, or an EXTNAME. The SIM writers (modules/sim_common.py\n    and the IMG-OPT-02 SIM) write BCKGD_SUBTED, RAW_READOUT, BACKGROUND (+ extras)\n    after a header-only primary, so BCKGD_SUBTED is extension 1 and RAW_READOUT\n    extension 2; some earlier SIM files had RAW_READOUT first. Prefer the EXTNAME.\n    Simpler FITS may only have HDU 0.\n\nOUTPUTS\n-------\ntuple[np.ndarray, Any]\n    Tuple containing a copy of the HDU data as a NumPy array and a copy of the HDU\n    header.", shape=ellipse];
    psf_grid_prep___open_fits_hdul [label="_open_fits_hdul\nOpen a FITS file with memmap off,\nfalling back to a /tmp copy on\nerrno 35", tooltip="Open a FITS file with memmap off, falling back to a /tmp copy on errno 35.", shape=ellipse];
    psf_grid_prep___select_image_hdu [label="_select_image_hdu\nReturn ``(hdu, index)`` for\n``preferred_index`` (an index or\nan EXTNAME) if usable, else the\nfirst image-bear…", tooltip="Return ``(hdu, index)`` for ``preferred_index`` (an index or an EXTNAME) if usable,\nelse the first image-bearing HDU in the file.", shape=ellipse];
  }
  subgraph cluster_stray_light_common {
    label="modules/stray_light_common.py";
    style=filled; fillcolor="#fde3e3"; color="#999999";
    stray_light_common__populate_result_obj_info [label="populate_result_obj_info\nPopulate the result object with\ninformation from the data state", tooltip="Populate the result object with information from the data state.\n\nINPUTS:\n- result_obj (StrayLightResult): result object\n- data_state (dict): data state\n- observing_config (ObservingConfig): observing config\n\nOUTPUTS:\n- result_obj (StrayLightResult): result object", shape=box, style="filled", fillcolor="white"];
    stray_light_common__centroid_2passes_oversample [label="centroid_2passes_oversample\nCentroid the PSF in the image of\nthe result object, starting from\nfirst guesses of the positions", tooltip="Centroid the PSF in the image of the result object, starting from first guesses of\nthe positions. This uses 2 passes for accuracy.\n\nINPUTS:\n- result_obj: result object\n- config_coords_guesses_file_name: path to the config file with the coordinates\n  guesses\n- psfs_subset: subset of PSFs to use, \"all\" or an int\n- oversample_factor: oversample factor\n- grid_header: header of the grid\n- centroid_box_size: size of the centroid box\n- zoom_order: order of the zoom\n- centroid_func: function to use for centroiding\n- centroid_sources_impl: implementation of the centroid_sources function\n\nOUTPUTS:\n- result_obj, with centroids set (2nd-pass centroid dict, see\n  psf_grid_prep.refine_2nd_pass_centroids)", shape=box, style="filled", fillcolor="white"];
    stray_light_common__stray_light_mask_real [label="stray_light_mask_real\nMask the real PSF, so we can find\nthe stray light", tooltip="Mask the real PSF, so we can find the stray light.\n\nThe mask is everything within psf_mask_n_lambda_over_d * lambda/D of the PSF\ncentroid, with psf_mask_n_lambda_over_d set in the observing config.\n\nINPUTS:\n- result_obj (StrayLightResult): result object\n- observing_config (ObservingConfig): observing config\n\nOUTPUTS:\n- result_obj, with real_psf_mask set", shape=box, style="filled", fillcolor="white"];
    stray_light_common__stray_light_segmentation_combined [label="stray_light_segmentation_combined\nSegment the stray light with a\nweighted combination of the\nmethods in SEGMENTATION_METHODS.", tooltip="Segment the stray light with a weighted combination of the methods in\nSEGMENTATION_METHODS.\n\nEach method with weight > 0 is run on the same denoised frame. Regions that overlap\nacross methods\nget the same label (see _combine_method_regions). A pixel is finally counted as\nstray light if\nΣ' > N * Σ, where Σ' is the summed weight of the methods detecting that pixel, Σ is\nthe sum of all\nweights, and N = vote_fraction.\n\nINPUTS:\n- result_obj: result object (needs image and real_psf_mask)\n- weights: {method: weight in [0, 1]}; methods left out get weight 1, weight 0 skips\n  a method.\n    If None, uses result_obj.segmentation_weights (e.g. from the data state), else\n    all 1.\n- vote_fraction: N in [0, 1]. If None, uses result_obj.segmentation_vote_fraction,\n    else SEGMENTATION_DEFAULT_VOTE_FRACTION\n- params: {method: {knob: value}} overriding SEGMENTATION_DEFAULT_PARAMS[method]; if\n  None,\n    uses result_obj.segmentation_params if set\n\nOUTPUTS:\n- result_obj (StrayLightResult), updated attributes:\n    - segment_map (np.ndarray[int32]): group labels of the final regions (0 = not\n      stray light)\n    - segmentation_method (str): 'combined'\n    - segmentation_weights, segmentation_vote_fraction: as used\n    - method_label_maps (dict): per method, group labels of its detections\n    - final_label_map (np.ndarray): group labels of the final regions (same as\n      segment_map)\n- FYI plots and FITS file in the result object's results_dir\n  (stray_light_segmentation_*_<stem>.png, stray_light_segmentation_combined_<stem>\n  .png/.fits)", shape=box, style="filled", fillcolor="white"];
    stray_light_common__stray_light_segmentation [label="stray_light_segmentation\nSegment the stray light", tooltip="Segment the stray light.\n\nIdeas and methods herein are from Eric Pantin's notebook for instructional purposes\n(dev_notebooks/TP_image_segmentation.ipynb). Many knobs remain to be tuned with real\ndata.\n\nINPUTS:\n- result_obj: result object (needs image and real_psf_mask)\n- method: segmentation method; one of SEGMENTATION_METHODS:\n    - 'threshold': global threshold (otsu/mean/median) of the denoised image, then\n      connected components\n    - 'hough_circle': circles fitted to bright blobs; each region is a filled circle\n    - 'active_contour': as 'hough_circle', but each circle is refined with an active\n      contour (snake)\n        and dilated by expand_px\n    - 'watershed': thresholded foreground split into touching blobs by\n      distance-transform seeds + watershed\n    - 'kmeans': k-means clustering of pixel intensities; the brightest cluster(s)\n      are stray light\n    - 'meanshift': mean-shift filtering, then an Otsu threshold of the filtered\n      image\n  If None, uses result_obj.segmentation_method (e.g. from the data state), else\n  'active_contour'.\n- params: dict overriding SEGMENTATION_DEFAULT_PARAMS[method]; if None, uses\n    result_obj.segmentation_params if set\n\nOUTPUTS:\n- result_obj (StrayLightResult), updated attributes:\n    - segment_map (np.ndarray[int32]): integer region labels (0 = not stray light),\n      regions labelled 1..n\n    - segmentation_method (str): the method used\n- FYI plot in the result object's results_dir", shape=box, style="filled", fillcolor="white"];
    stray_light_common___resolve_segmentation_weights [label="_resolve_segmentation_weights\nWeight per method: default 1.0 for\nevery method in\nSEGMENTATION_METHODS, overridden\nby 'weights'. Raises if a…", tooltip="Weight per method: default 1.0 for every method in SEGMENTATION_METHODS, overridden\nby 'weights'.\nRaises if a method is unknown, a weight is outside [0, 1], or all weights are 0.", shape=ellipse];
    stray_light_common___resolve_vote_fraction [label="_resolve_vote_fraction\nN in 'summed weight > N * sum(all\nweights)'; default SEGMENTATION_DE\nFAULT_VOTE_FRACTION, must be in\n[0, 1]", tooltip="N in 'summed weight > N * sum(all weights)'; default\nSEGMENTATION_DEFAULT_VOTE_FRACTION, must be in [0, 1].", shape=ellipse];
    stray_light_common___prepare_segmentation_image [label="_prepare_segmentation_image\nFill the masked real PSF with the\nbackground level and TV-denoise\nthe image", tooltip="Fill the masked real PSF with the background level and TV-denoise the image.\n\nOUTPUTS:\n- filled (ndarray): image with the PSF region replaced by the background median\n- tv (ndarray): TV-denoised version of 'filled', in the original units\n- psf_mask (ndarray[bool]): mask of the real PSF", shape=ellipse];
    stray_light_common__results_dir_of [label="results_dir_of\nResults directory of a result\nobject (created if needed)", tooltip="Results directory of a result object (created if needed).", shape=ellipse];
    stray_light_common__fits_stem_of [label="fits_stem_of\nInput FITS file name without\ndirectory and extension (for\noutput file names)", tooltip="Input FITS file name without directory and extension (for output file names).", shape=ellipse];
    stray_light_common___merge_method_params [label="_merge_method_params\nMerge user overrides 'params' over\nSEGMENTATION_DEFAULT_PARAMS[method\n], warning about unused keys", tooltip="Merge user overrides 'params' over SEGMENTATION_DEFAULT_PARAMS[method], warning\nabout unused keys.", shape=ellipse];
    stray_light_common___segment_single_method [label="_segment_single_method\nRun one segmentation method on the\ndenoised image (see\nstray_light_segmentation for the\nmethods)", tooltip="Run one segmentation method on the denoised image (see stray_light_segmentation for\nthe methods).\n\nINPUTS:\n- tv (ndarray): TV-denoised image, PSF filled with the background (from\n  _prepare_segmentation_image)\n- psf_mask (ndarray[bool]): mask of the real PSF\n- method (str): one of SEGMENTATION_METHODS\n- p (dict): full set of knobs for this method (defaults merged with overrides)\n\nOUTPUTS:\n- foreground (ndarray[uint8]): foreground used by the method (for plotting)\n- label_map (ndarray[int32]): 0 = no region; regions labelled 1..n, PSF excluded\n  (where regions of 'hough_circle' or 'active_contour' overlap, the later one wins)", shape=ellipse];
    stray_light_common___plot_segmentation [label="_plot_segmentation\nFYI plot: denoised image,\nforeground used by the method, and\nthe final region outlines; saved\nto plot_file_na…", tooltip="FYI plot: denoised image, foreground used by the method, and the final region\noutlines; saved to plot_file_name.", shape=ellipse];
    stray_light_common___combine_method_regions [label="_combine_method_regions\nCombine the regions found by\nseveral segmentation methods", tooltip="Combine the regions found by several segmentation methods.\n\nBookkeeping: the regions of all methods are OR-ed together, and each connected\ncomponent\n(8-connectivity) of that union is one 'group' with one label. So regions from\ndifferent methods\nwhich overlap (or touch) share a label; a group a method did not detect is absent\nfrom that\nmethod's label map.\n\nFinal regions: a pixel is in if the summed weight of the methods detecting it is\n> vote_fraction * (sum of all weights), and is not in the real PSF. Final regions\nkeep their group label.\n\nINPUTS:\n- method_region_maps (dict[str, ndarray]): per method, its label map (>0 = in a\n  region)\n- weights (dict[str, float]): weight per method (all methods, incl. those with\n  weight 0)\n- vote_fraction (float): N, in [0, 1]\n- psf_mask (ndarray[bool]): mask of the real PSF\n\nOUTPUTS:\n- dict with:\n    - group_labels (ndarray[int32]): label of each group (0 = no method detected\n      anything)\n    - method_label_maps (dict[str, ndarray[int32]]): per method, group labels where\n      it detected something\n    - score_map (ndarray[float]): summed weight of the methods detecting each pixel\n    - sigma (float): sum of all weights\n    - threshold (float): vote_fraction * sigma\n    - final_label_map (ndarray[int32]): group labels of the pixels passing the\n      weighted vote\n    - final_labels (list[int]): group labels with at least one final pixel", shape=ellipse];
    stray_light_common___plot_segmentation_combined [label="_plot_segmentation_combined\nFYI plot: image with each method's\nregions outlined in its own\ncolour, the final (weighted-vote)\nregions with…", tooltip="FYI plot: image with each method's regions outlined in its own colour, the final\n(weighted-vote)\nregions with a bold border, and each group's label; saved to plot_file_name.", shape=ellipse];
    stray_light_common___write_segmentation_combined_fits [label="_write_segmentation_combined_fits\nWrite the combined segmentation to\na FITS file of boolean maps\n(uint8: 1 = stray light region, 0\n= not): - PR…", tooltip="Write the combined segmentation to a FITS file of boolean maps (uint8: 1 = stray\nlight region, 0 = not):\n- PRIMARY: header only (input file, weights, vote fraction, threshold)\n- one extension per method that was run (EXTNAME = method): regions it detected\n- FINAL: regions from the weighted vote\nThe real PSF is always 0. Cross-method group labels are listed in each extension's\nLABELS keyword\n(and annotated in the combined FYI plot).", shape=ellipse];
    stray_light_common__StrayLightResult [label="StrayLightResult(...)", tooltip="Image, masks, segmentation and region statistics for one stray light FITS file.", shape=box, style="rounded,dashed,filled", fillcolor="white"];
  }
  subgraph cluster_backbone_img_opt_04_stray_light {
    label="modules/backbone_img_opt_04_stray_light.py";
    style=filled; fillcolor="#f8d8d8"; color="#999999";
    backbone_img_opt_04_stray_light__stray_light_brightness_spectrum [label="stray_light_brightness_spectrum\nSort out the segments into\nbrightnesses as function of\nspatial scales, and measure the\nquantities the require…", tooltip="Sort out the segments into brightnesses as function of spatial scales, and measure\nthe quantities the requirements are tested against (pass/fail itself is decided in\nmetis_1189_1429_check and metis_9522_check).\n\nINPUTS:\n- result_obj: result object, which should contain\n    - image (ndarray): science image\n    - segment_map (ndarray[int]): integer region labels (0 = not stray light)\n- observing_config: observing config\n\n\nOUTPUTS:\n- result_obj (StrayLightResult), updated attributes:\n    - regions (list[StrayLightRegion]): flux statistics and METIS-9522 limit of\n      each region\n    - psf_max (float): peak of the real PSF\n    - background_rms (float): per-pixel rms outside the PSF and the regions", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_04_stray_light__metis_1189_1429_check [label="metis_1189_1429_check\nDecide METIS-1189 (stray light <\n0.1% of the peak irradiance in the\nIMG focal planes) and METIS-1429\n(< 0.04%…", tooltip="Decide METIS-1189 (stray light < 0.1% of the peak irradiance in the IMG focal\nplanes) and METIS-1429 (< 0.04% in the IMG-LM and IMG-N detector planes): the peak\nirradiance of every stray light region is below METIS_1189_1429_PEAK_FRAC (the\nstricter 0.04%) of the PSF peak. No stray light regions: PASS.\n\nINPUTS:\n- result_obj (StrayLightResult): from stray_light_brightness_spectrum (regions,\n  psf_max)\n\nOUTPUTS:\n- result_obj (StrayLightResult), with pass_metis_1189_1429 set", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_04_stray_light__metis_9522_check [label="metis_9522_check\nDecide METIS-9522: the total flux\nof every stray light region is\nbelow 3-sigma of the background\nnoise of the…", tooltip="Decide METIS-9522: the total flux of every stray light region is below 3-sigma of\nthe background noise of the summed flux over the region's area (i.e. for its\nspatial scale; StrayLightRegion.metis_9522_limit). No stray light regions: PASS.\n\nINPUTS:\n- result_obj (StrayLightResult): from stray_light_brightness_spectrum (regions,\n  with metis_9522_limit)\n\nOUTPUTS:\n- result_obj (StrayLightResult), with pass_metis_9522 set", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_04_stray_light__log_test_outcome [label="log_test_outcome\nLog the outcome of each IMG-OPT-04\nrequirement (as decided by\nmetis_1189_1429_check and\nmetis_9522_check) and…", tooltip="Log the outcome of each IMG-OPT-04 requirement (as decided by metis_1189_1429_check\nand metis_9522_check) and of the whole test: PASS if both pass, else FAIL.\n\nINPUTS:\n- result_obj (StrayLightResult): with pass_metis_1189_1429 and pass_metis_9522 set\n\nOUTPUTS:\n- result_obj (StrayLightResult), with verdict_overall set", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_04_stray_light___overplot_method_brightnesses [label="_overplot_method_brightnesses\nOverplot surface brightness vs", tooltip="Overplot surface brightness vs. radius of the area-equivalent circle for each region\nas found by\neach segmentation method (combined segmentation only; no-op otherwise). One hollow\nmarker shape\nand colour per method; each point is annotated with its group label, marked if the\ngroup is not in\n'final_labels' (i.e. rejected by the weighted vote).", shape=ellipse];
  }

digraph overview {
  rankdir=TB;
  ranksep=0.35;
  newrank=true;
  label="IMG-OPT-02 Distortion (need distortion info): overview\npipeline stages (this test's + the shared ones it uses), then each stage's purpose and the result fields it writes";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  subgraph cluster_flow {
    label="pipeline stages"; style=rounded; color="#999999";
    node [shape=box, style="rounded,filled"];
    generate_distortion_sim [label="Generate distortion sims", fillcolor="#f2f2f2", style="rounded,dashed,filled"];
    image_distortion [label="Measure distortion", fillcolor="#ffe8d4", style="rounded,dashed,filled"];
    img_02_fyi_plots [label="FYI plots", fillcolor="#ffe8d4", style="rounded,dashed,filled"];
    img_02_test_outcome [label="IMG-OPT-02 pass/fail", fillcolor="#ffe8d4", style="rounded,dashed,filled", penwidth=2];
    metis_1097_pixel_scale [label="METIS-1097: pixel scale", fillcolor="#ffe8d4", style="rounded,dashed,filled"];
    metis_3502_residual_distortion [label="METIS-3502: residual distortion after calibration", fillcolor="#ffe8d4", style="rounded,dashed,filled"];
    metis_8222_detector_offset [label="METIS-8222: H2RG offset from optical axis", fillcolor="#ffe8d4", style="rounded,dashed,filled"];
    metis_9920_scale_stability [label="METIS-9920: stability of scale and distortion", fillcolor="#ffe8d4", style="rounded,dashed,filled"];
    sim_img_02_grid_frames [label="SIM pinhole-grid frames (no injection)", fillcolor="#f2f2f2", style="rounded,dashed,filled"];
    sim_img_02_grid_frames -> generate_distortion_sim;
    generate_distortion_sim -> image_distortion;
    image_distortion -> img_02_fyi_plots;
    metis_1097_pixel_scale -> img_02_test_outcome;
    metis_3502_residual_distortion -> img_02_test_outcome;
    metis_8222_detector_offset -> img_02_test_outcome;
    metis_9920_scale_stability -> img_02_test_outcome;
    image_distortion -> metis_1097_pixel_scale;
    image_distortion -> metis_3502_residual_distortion;
    image_distortion -> metis_8222_detector_offset;
    image_distortion -> metis_9920_scale_stability;
  }
  stage_table [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dddddd"><B>stage</B></TD><TD BGCOLOR="#dddddd"><B>module</B></TD><TD BGCOLOR="#dddddd"><B>purpose (docstring)</B></TD><TD BGCOLOR="#dddddd"><B>writes</B></TD></TR><TR><TD ALIGN="LEFT">generate_distortion_sim</TD><TD ALIGN="LEFT">IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM.py</TD><TD ALIGN="LEFT">Generate IMG-OPT-02 distortion simulations, as set in the<BR ALIGN="LEFT"/>scenario config<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">FITS case files (via sim_common)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">sim_img_02_grid_frames</TD><TD ALIGN="LEFT">IMG_OPT_02_METIS_AIT_img_cal_distortion_SIM.py</TD><TD ALIGN="LEFT">Unmodified pinhole-grid frame of one WCU set-up (no<BR ALIGN="LEFT"/>distortion injected yet), as<BR ALIGN="LEFT"/>IMG_OPT_02_&lt;req_key&gt;_&lt;instrument&gt;_reference.fits (sim_comm…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT">FITS case files (via sim_common)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">image_distortion</TD><TD ALIGN="LEFT">modules/backbone_img_opt_02_distortion.py</TD><TD ALIGN="LEFT">Measure Strehl-related quantities for a grid of PSFs, save<BR ALIGN="LEFT"/>the per-PSF results, and generate a summary diagnostic plot<BR ALIGN="LEFT"/>over the detector fr…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">metis_1097_pixel_scale</TD><TD ALIGN="LEFT">modules/backbone_img_opt_02_distortion.py</TD><TD ALIGN="LEFT">METIS-1097: the Imager shall provide a pixel scale of 5.47<BR ALIGN="LEFT"/>+0.26/-0.26 mas/pix for the LM-band and 6.79 +0.25/-0.50<BR ALIGN="LEFT"/>mas/pix for the N-band<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">metis_3502_residual_distortion</TD><TD ALIGN="LEFT">modules/backbone_img_opt_02_distortion.py</TD><TD ALIGN="LEFT">METIS-3502: after calibration, the distortions introduced by<BR ALIGN="LEFT"/>METIS shall be removed to better than 0.5 mas (ca<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">metis_8222_detector_offset</TD><TD ALIGN="LEFT">modules/backbone_img_opt_02_distortion.py</TD><TD ALIGN="LEFT">METIS-8222: the center of the H2RG chip within IMG-LM-DET<BR ALIGN="LEFT"/>shall be offset from the METIS optical axis by 175 mas +/-<BR ALIGN="LEFT"/>25 mas on-sky PtV in t…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">metis_9920_scale_stability</TD><TD ALIGN="LEFT">modules/backbone_img_opt_02_distortion.py</TD><TD ALIGN="LEFT">METIS-9920: image scale and distortion of METIS shall be<BR ALIGN="LEFT"/>constant (for each optical configuration, even after change<BR ALIGN="LEFT"/>of observing modes) to…<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">img_02_test_outcome</TD><TD ALIGN="LEFT">modules/backbone_img_opt_02_distortion.py</TD><TD ALIGN="LEFT">Decide and log the pass/fail of each IMG-OPT-02 requirement,<BR ALIGN="LEFT"/>and of the whole test<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  img_02_fyi_plots -> stage_table [style=invis];
  img_02_test_outcome -> stage_table [style=invis];
}

digraph dataflow {
  rankdir=LR;
  ranksep=0.9;
  nodesep=0.12;
  label="IMG-RAD-09 Nominal background behaviour: data flow of the result fields (ANALYSIS)\nsolid blue = stage writes the field, dashed grey = stage reads it; italic = property (derived)";
  labelloc=t;
  fontsize=14;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  node [shape=box, style="rounded,filled", fillcolor="white", penwidth=1.5];
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run [label="NoiseRunResult(...)\n(in populate_run)"];
  IMG_RAD_09_nominal_background_behavior_ANALYSIS_main [label="main", tooltip="Run the IMG-RAD-09 analysis for each data state (requirement, instrument,\ncase)."];
  backbone_img_rad_09_nom_measure_noise [label="measure_noise", tooltip="Measure the 1-sigma point-source noise of the frame in extension noise_hdu\n(RAW_READOUT: the readout itself, nothing subtracted; default BCKGD_SUBTED) in\nabsolute flux units: aperture sums (radius aperture_radius_lambda_over_d x\nlambda/D, on a grid in the field mask of the raw frame, away from the point\nsource: noise_mask), robust spread about their median, / DIT x counts-to-flux\ncalibration; and its uncertainty MAD_SIGMA_REL_ERR / sqrt(N apertures). If the\nsource is excluded, also its flux above the background in an aperture of the same\nradius (source_sum) and its S/N (for information).\n\nOUTPUTS:\n- NoiseRunResult, with measured/sigma['noise_flux'] (and 'source_flux',\n  'source_snr'), the aperture sums (flux) and the source positions"];
  backbone_img_rad_09_nom_plot_run [label="plot_run", tooltip="FYI plot in result.results_dir: histogram of the aperture sums (flux units) with\nthe Gaussian of the measured noise and +/- the limit.\n\nOUTPUTS:\n- str: written plot file"];
  backbone_img_rad_09_nom_log_test_outcome [label="log_test_outcome", tooltip="Log the outcome of the run's requirement and compare it with the injected truth\n(EXPECTED).\n\nOUTPUTS:\n- NoiseRunResult, with verdict_overall and consistent set"];
  backbone_img_rad_09_nom_log_summary [label="log_summary", tooltip="Log a table of all runs (requirement, instrument, case, noise, verdict, expected,\nconsistency with the injected truth).\n\nOUTPUTS:\n- int: number of runs inconsistent with the injected truth"];
  subgraph cluster_NoiseRunResult {
    label="NoiseRunResult (backbone_img_rad_09_nom)";
    style=filled; fillcolor="#fae7f4"; color="#999999";
    f_run_name [label="run_name", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_req_id [label="req_id", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_instrument [label="instrument", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_case [label="case", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_file_name [label="file_name", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_header [label="header", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_det_key [label="det_key", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_results_dir [label="results_dir", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_limits [label="limits", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_analysis_cfg [label="analysis_cfg", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_aperture_radius_px [label="aperture_radius_px", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_aperture_sums_flux [label="aperture_sums_flux", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_source_positions [label="source_positions", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_measured [label="measured", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_sigma [label="sigma", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_verdicts [label="verdicts", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_verdict_overall [label="verdict_overall", shape=note, style=filled, fillcolor="white", penwidth=1];
    f_consistent [label="consistent", shape=note, style=filled, fillcolor="white", penwidth=1];
  }
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run -> f_run_name [color="#1f77b4"];
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run -> f_req_id [color="#1f77b4"];
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run -> f_instrument [color="#1f77b4"];
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run -> f_case [color="#1f77b4"];
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run -> f_file_name [color="#1f77b4"];
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run -> f_header [color="#1f77b4"];
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run -> f_det_key [color="#1f77b4"];
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run -> f_results_dir [color="#1f77b4"];
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run -> f_limits [color="#1f77b4"];
  ctor_NoiseRunResult_backbone_img_rad_09_nom_populate_run -> f_analysis_cfg [color="#1f77b4"];
  f_file_name -> IMG_RAD_09_nominal_background_behavior_ANALYSIS_main [color="#888888", style=dashed];
  f_header -> IMG_RAD_09_nominal_background_behavior_ANALYSIS_main [color="#888888", style=dashed];
  f_req_id -> IMG_RAD_09_nominal_background_behavior_ANALYSIS_main [color="#888888", style=dashed];
  backbone_img_rad_09_nom_measure_noise -> f_source_positions [color="#1f77b4"];
  backbone_img_rad_09_nom_measure_noise -> f_aperture_radius_px [color="#1f77b4"];
  backbone_img_rad_09_nom_measure_noise -> f_aperture_sums_flux [color="#1f77b4"];
  f_analysis_cfg -> backbone_img_rad_09_nom_measure_noise [color="#888888", style=dashed];
  f_file_name -> backbone_img_rad_09_nom_measure_noise [color="#888888", style=dashed];
  f_header -> backbone_img_rad_09_nom_measure_noise [color="#888888", style=dashed];
  f_det_key -> backbone_img_rad_09_nom_measure_noise [color="#888888", style=dashed];
  f_measured -> backbone_img_rad_09_nom_measure_noise [color="#888888", style=dashed];
  f_run_name -> backbone_img_rad_09_nom_measure_noise [color="#888888", style=dashed];
  f_sigma -> backbone_img_rad_09_nom_measure_noise [color="#888888", style=dashed];
  f_results_dir -> backbone_img_rad_09_nom_plot_run [color="#888888", style=dashed];
  f_aperture_sums_flux -> backbone_img_rad_09_nom_plot_run [color="#888888", style=dashed];
  f_measured -> backbone_img_rad_09_nom_plot_run [color="#888888", style=dashed];
  f_limits -> backbone_img_rad_09_nom_plot_run [color="#888888", style=dashed];
  f_analysis_cfg -> backbone_img_rad_09_nom_plot_run [color="#888888", style=dashed];
  f_run_name -> backbone_img_rad_09_nom_plot_run [color="#888888", style=dashed];
  f_verdicts -> backbone_img_rad_09_nom_plot_run [color="#888888", style=dashed];
  f_req_id -> backbone_img_rad_09_nom_plot_run [color="#888888", style=dashed];
  backbone_img_rad_09_nom_log_test_outcome -> f_verdict_overall [color="#1f77b4"];
  backbone_img_rad_09_nom_log_test_outcome -> f_consistent [color="#1f77b4"];
  f_run_name -> backbone_img_rad_09_nom_log_test_outcome [color="#888888", style=dashed];
  f_req_id -> backbone_img_rad_09_nom_log_test_outcome [color="#888888", style=dashed];
  f_instrument -> backbone_img_rad_09_nom_log_test_outcome [color="#888888", style=dashed];
  f_case -> backbone_img_rad_09_nom_log_test_outcome [color="#888888", style=dashed];
  f_measured -> backbone_img_rad_09_nom_log_test_outcome [color="#888888", style=dashed];
  f_sigma -> backbone_img_rad_09_nom_log_test_outcome [color="#888888", style=dashed];
  f_limits -> backbone_img_rad_09_nom_log_test_outcome [color="#888888", style=dashed];
  f_aperture_radius_px -> backbone_img_rad_09_nom_log_test_outcome [color="#888888", style=dashed];
  f_verdicts -> backbone_img_rad_09_nom_log_test_outcome [color="#888888", style=dashed];
  f_header -> backbone_img_rad_09_nom_log_test_outcome [color="#888888", style=dashed];
  f_req_id -> backbone_img_rad_09_nom_log_summary [color="#888888", style=dashed];
  f_instrument -> backbone_img_rad_09_nom_log_summary [color="#888888", style=dashed];
  f_case -> backbone_img_rad_09_nom_log_summary [color="#888888", style=dashed];
  f_measured -> backbone_img_rad_09_nom_log_summary [color="#888888", style=dashed];
  f_verdict_overall -> backbone_img_rad_09_nom_log_summary [color="#888888", style=dashed];
  f_header -> backbone_img_rad_09_nom_log_summary [color="#888888", style=dashed];
  f_consistent -> backbone_img_rad_09_nom_log_summary [color="#888888", style=dashed];
}

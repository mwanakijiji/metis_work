  subgraph cluster_backbone_img_03_psf_quality {
    label="modules/backbone_img_03_psf_quality.py";
    style=filled; fillcolor="#d9eed9"; color="#999999";
    backbone_img_03_psf_quality__prepare_psf_grid [label="prepare_psf_grid\nLoad a FITS file with a grid of\nPSFs, resolve the mask-dependent\nobserving config, and find the\n1st-pass cent…", tooltip="Load a FITS file with a grid of PSFs, resolve the mask-dependent observing config,\nand find the 1st-pass centroids of the PSFs.\n\nINPUTS\n----------\nfile_name_abs : str\n    Path to the FITS file containing the PSF grid to analyze.\nfp_mask : str\n    Focal-plane mask label (sets the LM/N band).\npp_mask : str\n    Pupil-plane mask label (sets the reference aperture geometry).\nfilter_name : str, optional\n    Name of the observing filter associated with the PSF grid.\npsfs_subset : str or int, optional\n    Either ``\"all\"`` to process the full grid or an integer giving how many PSFs\n    from the start of the centroid list to process.\nconfig_coords_guesses_file_name_abs : str, optional\n    Path to the configuration file containing initial coordinate guesses.\nconfig_observing : dict, optional\n    Observing configuration dictionary.\noversample_factor : int, optional\n    Oversampling factor for centroiding and fitting (keep odd to facilitate\n    centering).\n\nOUTPUTS\n-------\nPsfGrid\n    The frame, the resolved observing config, the 1st-pass centroids and PSF\n    counts; input to cutout_psf / process_one_psf, collect_strehls and\n    plot_strehl_fov.", shape=box, style="filled", fillcolor="white"];
    backbone_img_03_psf_quality__process_one_psf [label="process_one_psf\nProcess one PSF cutout by\noversampling it, centroiding it\nwith a Gaussian fit, and\noptionally evaluating addi…", tooltip="Process one PSF cutout by oversampling it, centroiding it with a Gaussian fit,\nand optionally evaluating additional Strehl estimators.\n\nINPUTS\n----------\nnum_coord : int\n    Zero-based index of the PSF currently being processed.\nnum_psfs_to_process : int\n    Total number of PSFs being processed from this detector image.\ncookie_cutout_original_this_psf : np.ndarray\n    Native-sampling square cutout containing the PSF of interest (e.g. from\n    cutout_psf).\noversample_factor : int\n    Factor used to oversample the PSF cutout before centroiding and model fitting.\nfilter_name : str\n    Name of the observing filter associated with the PSF.\nfp_mask : str\n    Focal-plane mask label used for bookkeeping and plot naming.\npp_mask : str\n    Pupil-plane mask label used for bookkeeping and plot naming.\nconfig_observing : dict\n    Observing configuration dictionary with mask-dependent values resolved (e.g.\n    PsfGrid.config_observing), passed to downstream fitting routines.\nresults_write_dir : str\n    Directory where diagnostic plots and fit products are written.\nfit_method : str\n    Name of the fitting backend to use for the free annular-aperture fit.\nfit_simmed_psf : bool\n    Whether to evaluate the ScopeSim-based Strehl workflow if enabled.\nfit_annular_aperture_fixed : bool\n    Whether to evaluate the fixed-geometry annular-aperture Strehl fit.\nfit_annular_aperture_free : bool\n    Whether to evaluate the free-geometry annular-aperture Strehl fit.\n\nOUTPUTS\n-------\nSinglePsfFitResult\n    Dataclass containing the Gaussian-fit centroid/FWHM/amplitude values in native\n    pixel units, the Gaussian-based Strehl estimate, and any optional Strehl\n    metrics (input to collect_strehls).", shape=box, style="filled", fillcolor="white"];
    backbone_img_03_psf_quality__cutout_psf [label="cutout_psf\nNative-sampling square cutout of\nPSF num_coord, around the closest\nints to its 1st-pass centroid\n(input to pr…", tooltip="Native-sampling square cutout of PSF num_coord, around the closest ints to its\n1st-pass centroid (input to process_one_psf).\n\nINPUTS\n----------\npsf_grid : PsfGrid\n    From prepare_psf_grid.\nnum_coord : int\n    Zero-based index of the PSF.\n\nOUTPUTS\n-------\nnp.ndarray\n    Cutout of side psf_grid.edge_size_original (native pixels).", shape=ellipse];
    backbone_img_03_psf_quality__collect_strehls [label="collect_strehls\nGather the per-PSF fit results (in\nthe order of the 1st-pass\ncentroids) into one result for the\nfile", tooltip="Gather the per-PSF fit results (in the order of the 1st-pass centroids) into one\nresult for the file.\n\nINPUTS\n----------\npsf_grid : PsfGrid\n    From prepare_psf_grid.\nfit_results : list[SinglePsfFitResult]\n    From process_one_psf, one per PSF processed (index = num_coord).\n\nOUTPUTS\n-------\nStrehlRunResult\n    Per-PSF Strehl estimates (+ 1st-pass centroids) and PSF counts; verdicts still\n    empty (see the requirement checks and log_test_outcome).", shape=box, style="filled", fillcolor="white"];
    backbone_img_03_psf_quality__plot_strehl_fov [label="plot_strehl_fov\nFYI plots on the detector frame:\nthe Strehl of each PSF, and the\nStrehl from all methods for one\nrandomly cho…", tooltip="FYI plots on the detector frame: the Strehl of each PSF, and the Strehl from all\nmethods for one randomly chosen PSF.\n\nINPUTS\n----------\nrun_result : StrehlRunResult\n    From collect_strehls.\ngrid_data : np.ndarray\n    The detector frame (native pixel scale), e.g. PsfGrid.grid_data.\nresults_write_dir : str\n    Directory where the plots are saved.\n\nOUTPUTS\n-------\nNone\n    Saves the plots.", shape=box, style="filled", fillcolor="white"];
    backbone_img_03_psf_quality__metis_1408_1409_check [label="metis_1408_1409_check\nDecide METIS-1408 (Strehl >= 80%\nat lambda > 3 um in all modes over\nthe entire FOV) and METIS-1409\n(Strehl >…", tooltip="Decide METIS-1408 (Strehl >= 80% at lambda > 3 um in all modes over the entire FOV)\nand METIS-1409 (Strehl > 0.8 at 3 um for IMG-LM and -NQ over the full FOV): every\nPSF has Strehl (criterion_key) >= strehl_min (see _strehl_verdict for FAIL /\nINCONCLUSIVE / NOT EVALUATED).\n\nINPUTS:\n- run_result (StrehlRunResult): from collect_strehls\n- criterion_key (str): Strehl estimator used for pass/fail\n- strehl_min (float): minimum Strehl ratio\n\nOUTPUTS:\n- run_result (StrehlRunResult), with verdicts['METIS-1408'] and\n  verdicts['METIS-1409'] set", shape=box, style="filled", fillcolor="white"];
    backbone_img_03_psf_quality__metis_2864_check [label="metis_2864_check\nDecide METIS-2864 (minimum Strehl\nof the WCU+CFO+IMG-LM optical path\n> 80% at 3.3 um over the entire\nFOV): th…", tooltip="Decide METIS-2864 (minimum Strehl of the WCU+CFO+IMG-LM optical path > 80% at\n3.3 um over the entire FOV): the same Strehl criterion as metis_1408_1409_check,\nfor LM data only; N/A for N-band data.\n\nINPUTS:\n- run_result (StrehlRunResult): from collect_strehls\n- criterion_key (str): Strehl estimator used for pass/fail\n- strehl_min (float): minimum Strehl ratio\n\nOUTPUTS:\n- run_result (StrehlRunResult), with verdicts['METIS-2864'] set", shape=box, style="filled", fillcolor="white"];
    backbone_img_03_psf_quality__metis_3503_check [label="metis_3503_check\nDecide METIS-3503 (the shape of\nthe instrument PSF can be\ncharacterised across the entire\nFoV using the WCU):…", tooltip="Decide METIS-3503 (the shape of the instrument PSF can be characterised across the\nentire FoV using the WCU): PASS if every PSF in the grid was analysed and has a\nfinite Strehl estimate (criterion_key); FAIL if any analysed PSF has a non-finite\none; INCONCLUSIVE if only a subset of the grid was analysed; NOT EVALUATED if\ncriterion_key is missing for some PSF.\n\nINPUTS:\n- run_result (StrehlRunResult): from collect_strehls\n- criterion_key (str): Strehl estimator whose fit must have succeeded\n\nOUTPUTS:\n- run_result (StrehlRunResult), with verdicts['METIS-3503'] set", shape=box, style="filled", fillcolor="white"];
    backbone_img_03_psf_quality__log_test_outcome [label="log_test_outcome\nLog the outcome of each IMG-OPT-03\nrequirement (as decided by\nmetis_1408_1409_check,\nmetis_2864_check and met…", tooltip="Log the outcome of each IMG-OPT-03 requirement (as decided by\nmetis_1408_1409_check, metis_2864_check and metis_3503_check) and of the whole\ntest: PASS if all applicable requirements pass; FAIL if any fails; else\nINCONCLUSIVE.\n\nINPUTS:\n- run_result (StrehlRunResult): with verdicts set by the requirement checks\n\nOUTPUTS:\n- run_result (StrehlRunResult), with verdict_overall set", shape=box, style="filled", fillcolor="white"];
    backbone_img_03_psf_quality__resolve_config_for_masks [label="resolve_config_for_masks\nReturn a shallow copy of the\nobserving config with mask-\ndependent values resolved", tooltip="Return a shallow copy of the observing config with mask-dependent values resolved.\n\nINPUTS\n----------\nconfig_observing : dict\n    Observing configuration dictionary (left unmodified).\nfp_mask : str\n    Focal-plane mask label (e.g. ``grid_lm``, ``pinhole_n``); sets the LM/N band.\npp_mask : str\n    Cold-stop (pupil-plane mask) label; selects the reference aperture geometry.\n\nOUTPUTS\n-------\ndict\n    Copy of ``config_observing`` with ``D_aperture`` taken from\n    ``D_aperture_by_pupil_mask[pp_mask]`` (if listed), plus the band-neutral keys\n    ``band``, ``pixel_scale_mas``, ``monochromatic_observing_filters``,\n    ``polychromatic_observing_filters_leaf_name`` (absolute filter curve paths,\n    under the IRDB) and ``cutout_edge_native``.", shape=ellipse];
    backbone_img_03_psf_quality___strehl_verdict [label="_strehl_verdict\nVerdict of the Strehl criterion\n(every PSF has Strehl >=\nstrehl_min) over the FOV: FAIL if\nany PSF is below;…", tooltip="Verdict of the Strehl criterion (every PSF has Strehl >= strehl_min) over the FOV:\nFAIL if any PSF is below; PASS if none is and the whole grid was analysed;\nINCONCLUSIVE if none is but only a subset of the grid was analysed; NOT EVALUATED\nif criterion_key is missing for some PSF (e.g. that fit was switched off).", shape=ellipse];
    backbone_img_03_psf_quality___criterion_strehls [label="_criterion_strehls\nPer PSF, the Strehl estimate used\nfor pass/fail (None where it was\nnot computed), and the PSFs where\nit is mi…", tooltip="Per PSF, the Strehl estimate used for pass/fail (None where it was not computed),\nand the PSFs where it is missing.", shape=ellipse];
    backbone_img_03_psf_quality___full_grid [label="_full_grid\nWhether every PSF of the grid was\nanalysed (i.e", tooltip="Whether every PSF of the grid was analysed (i.e. the entire FOV).", shape=ellipse];
    backbone_img_03_psf_quality__PsfGrid [label="PsfGrid(...)", tooltip="One FITS file of PSFs, loaded and 1st-pass centroided (from prepare_psf_grid):\neverything needed to cut out and fit each PSF. (Not to be confused with\npsf_grid_prep.PsfGridPrep, the lower-level centroiding output it is built from.)", shape=box, style="rounded,dashed,filled", fillcolor="white"];
    backbone_img_03_psf_quality__SinglePsfFitResult [label="SinglePsfFitResult(...)", tooltip="Per-PSF outputs from Gaussian fit (native pixel coords) and optional Strehl dicts.", shape=box, style="rounded,dashed,filled", fillcolor="white"];
    backbone_img_03_psf_quality__StrehlRunResult [label="StrehlRunResult(...)", tooltip="Strehl results for all PSFs of one FITS file (from collect_strehls), plus the\nrequirement verdicts (from the requirement checks) and the overall verdict (from\nlog_test_outcome).", shape=box, style="rounded,dashed,filled", fillcolor="white"];
  }

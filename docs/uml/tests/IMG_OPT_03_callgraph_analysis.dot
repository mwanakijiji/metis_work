    IMG_OPT_03_METIS_AIT_img_cal_psf_quality_ANALYSIS__check_saturation [label="check_saturation\nLog an error if the max counts in\nimage extension ``hdu_index`` (the\nraw readout, before background\nsubtracti…", tooltip="Log an error if the max counts in image extension ``hdu_index`` (the raw readout,\nbefore background subtraction) exceed ``frac`` of the detector saturation level.\nDoes not stop the analysis.", shape=ellipse];
  }
  subgraph cluster_paths {
    label="modules/paths.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    paths__project_root [label="project_root\nThe project root\n(METIS_MAIT_code_eckhart/), as set\nin config/paths.yaml", tooltip="The project root (METIS_MAIT_code_eckhart/), as set in config/paths.yaml.\n\nOUTPUTS\n-------\nstr\n    Absolute path, ending in '/' (scripts append to it, e.g. stem + \"data/\").", shape=ellipse];

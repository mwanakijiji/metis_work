  label="IMG-OPT-06 Out-of-field stray light: ANALYSIS call graph (IMG_OPT_06_METIS_AIT_out_of_field_ANALYSIS.py)\nbox = @pipeline_stage, oval = helper, dashed box = class instantiated, dashed arrow = passed as callback; numbers = call order in main(); hover for the full docstring";

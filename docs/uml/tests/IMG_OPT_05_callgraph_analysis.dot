  }
  subgraph cluster_helpers {
    label="modules/helpers.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    helpers__setup_logging [label="setup_logging\nInitialize logging with a file +\nconsole handler and pipe basic\nmetadata", tooltip="Initialize logging with a file + console handler and pipe basic metadata.\n\nINPUTS\n----------\nlog_dir : str\n    Directory where the log file should be written.\nlog_file_name : str\n    Full path to the output log file.\nnow : datetime.datetime, optional\n    Timestamp used for the \"created at\" log line. If None, that line is skipped.\n\nOUTPUTS\n-------\nNone\n    Configures the root logger and writes startup log lines.", shape=ellipse];
    helpers__load_config_and_pipe [label="load_config_and_pipe\nLoad a YAML configuration file and\npipe its contents to the log", tooltip="Load a YAML configuration file and pipe its contents to the log.\n\nINPUTS\n----------\nconfig_file_choice : str\n    Path to the configuration file.\nprint_one_line : bool, optional\n    If True, log the entire config on a single line. If False (default), log\n    in a more readable, multiline format.\n\nOUTPUTS\n-------\nconfig_this : dict\n    The configuration dictionary loaded from file.", shape=ellipse];
  }
  subgraph cluster_config_common {
    label="modules/config_common.py";
    style=filled; fillcolor="#e8f0fb"; color="#999999";
    config_common__load_observing_config [label="load_observing_config\nLoad the common observing config,\nthen merge each test-specific\nconfig on top, in order (top-level\nkeys of la…", tooltip="Load the common observing config, then merge each test-specific config on top, in\norder (top-level keys of later files override earlier ones).\n\nINPUTS\n----------\nstem : str\n    Project root (METIS_MAIT_code_eckhart/), prepended to relative paths.\n*test_config_files : str\n    Test-specific observing configs, relative to stem or absolute.\n\nOUTPUTS\n-------\ndict\n    The merged observing config.", shape=ellipse];
  }
  subgraph cluster_analysis_common {
    label="modules/analysis_common.py";
    style=filled; fillcolor="#fde3e3"; color="#999999";
    analysis_common__load_data_states [label="load_data_states\nData states from a config with\n'defaults' and 'runs': each run is\nthe defaults overridden by the\nrun's entrie…", tooltip="Data states from a config with 'defaults' and 'runs': each run is the defaults\noverridden by the run's entries, with the relative paths named in path_keys (if\npresent) prefixed with stem.\n\nINPUTS:\n- stem (str): project root, ending in '/'\n- config_file (str): data-states config, relative to stem or absolute\n- path_keys (iterable of str): keys holding paths relative to stem\n\nOUTPUTS:\n- list[dict]: one merged dict per run", shape=ellipse];
    analysis_common__check_saturation [label="check_saturation\nLog an error if the max counts in\nimage extension hdu_index (the raw\nreadout, before background\nsubtraction)…", tooltip="Log an error if the max counts in image extension hdu_index (the raw readout,\nbefore background subtraction) exceed frac of the saturation level. Does not stop\nthe analysis.\n\nOUTPUTS:\n- bool: True if the check passed", shape=ellipse];
  }
  subgraph cluster_backbone_img_opt_05_optomech_stability {
    label="modules/backbone_img_opt_05_optomech_stability.py";
    style=filled; fillcolor="#f3f3d7"; color="#999999";
    backbone_img_opt_05_optomech_stability__populate_run [label="populate_run\nSet up one run from a data state:\nits sequence of files (the\nfile_name_pattern glob), sorted by\nDATE-OBS, the…", tooltip="Set up one run from a data state: its sequence of files (the file_name_pattern\nglob), sorted by DATE-OBS, their primary headers, the detector (from the FILTER\ncard), its pixel scale (pixel_scales in the common observing config; warning if\nthe header's PIXSCALE differs) and the limits and analysis parameters from the\nIMG-OPT-05 observing config (warning if a header's limit differs).\n\nOUTPUTS:\n- StabilityRunResult", shape=ellipse];
    backbone_img_opt_05_optomech_stability__measure_positions [label="measure_positions\nMeasure the pupil centre\n(pupil_centre) of each frame of\nthe run (BCKGD_SUBTED), one frame\nat a time, and the…", tooltip="Measure the pupil centre (pupil_centre) of each frame of the run (BCKGD_SUBTED),\none frame at a time, and the frame times (DATE-OBS). Warns if the sequence's span\ndiffers from the run's timescale by more than span_tolerance.\n\nOUTPUTS:\n- StabilityRunResult, with times, centres, centre_sigmas, radii", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_05_optomech_stability__plot_run [label="plot_run\nFYI plot in result.results_dir:\nthe measured pupil offsets (mas on\nsky) vs", tooltip="FYI plot in result.results_dir: the measured pupil offsets (mas on sky) vs. time,\nwith their noise, and the injected offsets (SHIFT_X/Y) if there; and the offsets\nin the x-y plane with the limit as a circle.\n\nOUTPUTS:\n- list[str]: written plot files", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_05_optomech_stability__log_test_outcome [label="log_test_outcome\nLog the outcome of the run's\nrequirement (as decided by\nmetis_5422_check) and compare it\nwith the injected tr…", tooltip="Log the outcome of the run's requirement (as decided by metis_5422_check) and\ncompare it with the injected truth (EXPECTED).\n\nOUTPUTS:\n- StabilityRunResult, with verdict_overall and consistent set", shape=box, style="filled", fillcolor="white"];
    backbone_img_opt_05_optomech_stability__log_summary [label="log_summary\nLog a table of all runs\n(requirement, instrument,\ntimescale, case, RMS, verdict,\nexpected, consistency with t…", tooltip="Log a table of all runs (requirement, instrument, timescale, case, RMS, verdict,\nexpected, consistency with the injected truth); METIS-1230 is NOT EVALUATED (no\nSIM data).\n\nOUTPUTS:\n- int: number of runs inconsistent with the injected truth", shape=ellipse];
    backbone_img_opt_05_optomech_stability__detector_of_filter [label="detector_of_filter\n'img_lm' or 'img_n': the detector\nwhose filter list has filter_name", tooltip="'img_lm' or 'img_n': the detector whose filter list has filter_name.", shape=ellipse];
    backbone_img_opt_05_optomech_stability__pupil_centre [label="pupil_centre\nCentre of a sharp pupil image in a\nbackground-subtracted frame", tooltip="Centre of a sharp pupil image in a background-subtracted frame.\n\n1. First guess: pixels above half the 99th percentile; their centroid, and the\n   radius from their area (R = sqrt(N / pi)).\n2. Pupil level: median inside inner_frac x R; per-pixel noise: 1.4826 x MAD\n   inside (sigma_in) and in an annulus just outside the pupil (sigma_out).\n3. n_iter times: centroid of clip(frame / level, 0, 1) in the circle of radius\n   R + margin_px around the current centre (_window_centroid).\n\nOUTPUTS:\n- ndarray: centre (x, y) [px, 0-based pixel centres]\n- ndarray: its noise sigma (x, y) [px]\n- float: radius [px]\n- float: pupil level [ADU]", shape=ellipse];
    backbone_img_opt_05_optomech_stability__frame_times [label="frame_times\nSeconds since the first frame,\nfrom the DATE-OBS cards", tooltip="Seconds since the first frame, from the DATE-OBS cards.", shape=ellipse];
    backbone_img_opt_05_optomech_stability__StabilityRunResult [label="StabilityRunResult(...)", tooltip="One IMG-OPT-05 run (requirement, instrument, timescale, case): a sequence.", shape=box, style="rounded,dashed,filled", fillcolor="white"];
  }
